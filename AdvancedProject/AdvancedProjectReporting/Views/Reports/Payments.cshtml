@model AdvancedProjectReporting.Dtos.PaymentReportDto
@{
    ViewData["Title"] = "Payment Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Payment Report</h2>
    <span class="text-muted small">Generated @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
</div>

@if (Model == null)
{
    <div class="alert alert-info">No payment data available.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Total Collected</h5>
                    <p class="card-text fs-3 fw-bold">BD @Model.TotalCollected.ToString("N2")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Total Outstanding</h5>
                    <p class="card-text fs-3 fw-bold">BD @Model.TotalOutstanding.ToString("N2")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Overdue Payments</h5>
                    <p class="card-text fs-3 fw-bold">@Model.OverdueCount</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.OverduePayments.Any())
    {
        <div class="card">
            <div class="card-header fw-semibold text-danger">Overdue Payment Details</div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Tenant</th>
                            <th>Unit</th>
                            <th class="text-end">Amount Due (BD)</th>
                            <th class="text-center">Due Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.OverduePayments)
                        {
                            <tr>
                                <td>@p.TenantName</td>
                                <td>@p.UnitNumber</td>
                                <td class="text-end">@p.AmountDue.ToString("N2")</td>
                                <td class="text-center text-danger">@p.DueDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success">No overdue payments.</div>
    }
}
