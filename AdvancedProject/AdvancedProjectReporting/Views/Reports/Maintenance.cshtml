@model AdvancedProjectReporting.Dtos.MaintenanceReportDto
@{
    ViewData["Title"] = "Maintenance Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Maintenance Report</h2>
    <span class="text-muted small">Generated @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
</div>

@if (Model == null)
{
    <div class="alert alert-info">No maintenance data available.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <h5 class="card-title">Total Requests</h5>
                    <p class="card-text fs-3 fw-bold">@Model.TotalRequests</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Pending</h5>
                    <p class="card-text fs-3 fw-bold">@Model.PendingRequests</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">In Progress</h5>
                    <p class="card-text fs-3 fw-bold">@Model.InProgressRequests</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Resolved</h5>
                    <p class="card-text fs-3 fw-bold">@Model.ResolvedRequests</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header fw-semibold">Avg. Resolution Time</div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <span class="fs-2 fw-bold text-primary">
                        @Model.AverageResolutionDays.ToString("F1") days
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header fw-semibold">Requests by Skill Type</div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Skill Type</th>
                                <th class="text-center">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.ByType)
                            {
                                <tr>
                                    <td>@t.Type</td>
                                    <td class="text-center">@t.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
