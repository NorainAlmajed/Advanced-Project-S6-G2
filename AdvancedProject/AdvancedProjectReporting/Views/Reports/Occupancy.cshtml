@model List<AdvancedProjectReporting.Dtos.OccupancyReportDto>
@{
    ViewData["Title"] = "Occupancy Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Occupancy Report</h2>
    <span class="text-muted small">Generated @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No property data available.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Units</h5>
                    <p class="card-text fs-3 fw-bold">@Model.Sum(p => p.TotalUnits)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Occupied</h5>
                    <p class="card-text fs-3 fw-bold">@Model.Sum(p => p.OccupiedUnits)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Vacant</h5>
                    <p class="card-text fs-3 fw-bold">@Model.Sum(p => p.VacantUnits)</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">Breakdown by Building</div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Building</th>
                        <th class="text-center">Total Units</th>
                        <th class="text-center">Occupied</th>
                        <th class="text-center">Vacant</th>
                        <th class="text-center">Occupancy Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.BuildingName</td>
                            <td class="text-center">@row.TotalUnits</td>
                            <td class="text-center">@row.OccupiedUnits</td>
                            <td class="text-center">@row.VacantUnits</td>
                            <td class="text-center">
                                <div class="progress" style="height:20px;">
                                    <div class="progress-bar bg-success"
                                         style="width:@row.OccupancyRate.ToString("F0")%">
                                        @row.OccupancyRate.ToString("F1")%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
