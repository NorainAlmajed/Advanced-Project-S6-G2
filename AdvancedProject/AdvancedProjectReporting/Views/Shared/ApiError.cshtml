@{
    ViewData["Title"] = "Service Unavailable";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
    <div style="width:80px;height:80px;border-radius:50%;background:rgba(220,53,69,0.12);
                display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem;">
        <i class="bi bi-plug" style="font-size:2.2rem;color:#b42318;"></i>
    </div>

    <h2 style="font-size:1.8rem;font-weight:900;color:var(--text-main);margin-bottom:0.5rem;">
        API Server Unreachable
    </h2>
    <p style="color:var(--text-muted);font-size:1rem;max-width:440px;margin-bottom:2rem;">
        The Reporting application cannot connect to the API on
        <strong>localhost:7211</strong>. Make sure the API project is running
        as part of the Multi-Startup configuration, then refresh the page.
    </p>

    <div class="d-flex gap-3">
        <a href="javascript:location.reload()"
           class="btn" style="background:linear-gradient(135deg,#005B71,#1E8E6E);
                              color:white;border-radius:14px;font-weight:700;
                              padding:0.7rem 1.4rem;">
            <i class="bi bi-arrow-clockwise me-2"></i>Retry
        </a>
        <a asp-controller="Login" asp-action="Logout"
           style="background:#E8F1F3;color:#005B71;border-radius:14px;font-weight:700;
                  padding:0.7rem 1.4rem;text-decoration:none;display:inline-flex;align-items:center;">
            <i class="bi bi-box-arrow-left me-2"></i>Back to Login
        </a>
    </div>
</div>
