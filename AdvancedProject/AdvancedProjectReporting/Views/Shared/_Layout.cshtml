<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rentify Reports</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand app-brand" asp-controller="Reports" asp-action="Index">
                    Rentify <span style="color:var(--accent);font-weight:800;">Reports</span>
                </a>

                <button class="navbar-toggler app-navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#reportNavbar"
                        aria-controls="reportNavbar" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="reportNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center nav-pill-group">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(ViewData["Title"]?.ToString() == "Dashboard" ? "active" : "")"
                               asp-controller="Reports" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(ViewData["Title"]?.ToString() == "Occupancy Report" ? "active" : "")"
                               asp-controller="Reports" asp-action="Occupancy">Occupancy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(ViewData["Title"]?.ToString() == "Maintenance Report" ? "active" : "")"
                               asp-controller="Reports" asp-action="Maintenance">Maintenance</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(ViewData["Title"]?.ToString() == "Payment Report" ? "active" : "")"
                               asp-controller="Reports" asp-action="Payments">Payments</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            <span>&copy; 2026 - Rentify Reports</span>
            <span class="footer-divider">•</span>
            <span>Property Manager Portal</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
