@model AdvancedProjectReporting.Dtos.LoginRequest
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rentify Reports — Sign In</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --primary: #005B71;
            --accent:  #1E8E6E;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #005B71, #0a7f8f);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.18);
        }

        .login-header {
            padding: 2.5rem 2.5rem 1.75rem;
            background: linear-gradient(135deg, #005B71, #1E8E6E);
            color: white;
            text-align: center;
        }

        .login-brand {
            font-size: 1.9rem;
            font-weight: 900;
            letter-spacing: -0.02em;
            margin-bottom: 0.2rem;
        }

        .login-subtitle {
            font-size: 0.95rem;
            opacity: 0.88;
            font-weight: 500;
        }

        .login-body {
            padding: 2rem 2.5rem 2.5rem;
        }

        .login-label {
            font-size: 0.9rem;
            font-weight: 700;
            color: #374151;
            margin-bottom: 0.45rem;
        }

        .login-input {
            min-height: 52px;
            border-radius: 14px;
            border: 1px solid rgba(0,91,113,0.15);
            background: #f8fbfb;
            font-size: 1rem;
            color: #1F2937;
            padding: 0.75rem 1rem;
        }

            .login-input:focus {
                border-color: var(--primary);
                background: #ffffff;
                box-shadow: 0 0 0 0.2rem rgba(0,91,113,0.10);
            }

        .login-btn {
            width: 100%;
            min-height: 52px;
            border-radius: 14px;
            font-weight: 800;
            font-size: 1.05rem;
            background: linear-gradient(135deg, #005B71, #1E8E6E);
            border: none;
            color: white;
            margin-top: 0.5rem;
            transition: opacity 0.2s ease;
        }

            .login-btn:hover {
                opacity: 0.9;
                color: white;
            }

        .login-error {
            background: rgba(220,53,69,0.10);
            border: none;
            border-radius: 12px;
            color: #b42318;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.8rem 1rem;
        }

        .login-footer-note {
            text-align: center;
            font-size: 0.82rem;
            color: #9CA3AF;
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <div class="login-brand">
                Rentify <span style="font-weight:400;opacity:0.9;">Reports</span>
            </div>
            <div class="login-subtitle">Property Manager Portal — Sign in to continue</div>
        </div>

        <div class="login-body">
            @if (!ViewData.ModelState.IsValid)
            {
                foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="login-error mb-3">@error.ErrorMessage</div>
                }
            }

            <form asp-action="Index" method="post">
                <div class="mb-3">
                    <label class="login-label">Email address</label>
                    <input asp-for="Email" type="email" class="form-control login-input"
                           placeholder="manager@example.com" autocomplete="email" />
                </div>

                <div class="mb-3">
                    <label class="login-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control login-input"
                           placeholder="••••••••" autocomplete="current-password" />
                </div>

                <button type="submit" class="btn login-btn">Sign In</button>
            </form>

            <p class="login-footer-note">
                Access restricted to Property Managers only.
            </p>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
