@model AdvancedProjectReporting.Dtos.LoginRequest
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Rentify Reports</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary: #005B71;
            --accent:  #1E8E6E;
            --text-main: #1F2937;
            --text-muted: #6B7280;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            display: flex;
            font-family: system-ui, -apple-system, sans-serif;
            background: #0d1b2a;
        }

        /* ── Left panel — branding ── */
        .login-left {
            width: 45%;
            min-height: 100vh;
            background-image:
                linear-gradient(135deg,
                    rgba(13,27,42,0.88) 0%,
                    rgba(0,55,75,0.70) 45%,
                    rgba(13,27,42,0.85) 100%),
                url('/images/property2.jpg');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 2.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .login-logo {
            width: 90px;
            height: 90px;
            border-radius: 22px;
            object-fit: contain;
            /* No background box — floats on the image naturally */
            background: transparent;
            padding: 0;
            margin-bottom: 1.5rem;
            /* Subtle drop-shadow keeps it readable without a box */
            filter: drop-shadow(0 4px 16px rgba(0,0,0,0.45));
        }

        .login-brand-name {
            font-size: 2.4rem;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.03em;
            margin-bottom: 0.3rem;
            text-shadow: 0 2px 12px rgba(0,0,0,0.35);
        }

        .login-brand-sub {
            font-size: 0.95rem;
            color: rgba(255,255,255,0.55);
            font-weight: 500;
            letter-spacing: 0.02em;
            margin-bottom: 2.75rem;
        }

        .login-feature-list {
            list-style: none;
            width: 100%;
            max-width: 260px;
        }

            .login-feature-list li {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.5rem 0;
                font-size: 0.88rem;
                color: rgba(255,255,255,0.6);
                /* No separator lines — blend seamlessly */
                border-bottom: none;
            }

                .login-feature-list li i {
                    color: var(--accent);
                    font-size: 0.95rem;
                    flex-shrink: 0;
                    /* Slight glow to make icons pop without a box */
                    filter: drop-shadow(0 0 4px rgba(30,142,110,0.5));
                }

        /* ── Right panel — form ── */
        .login-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f7fafb;
            padding: 2.5rem 2rem;
        }

        .login-form-wrap {
            width: 100%;
            max-width: 400px;
        }

        .login-form-header {
            margin-bottom: 2rem;
        }

        .login-eyebrow {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--accent);
            margin-bottom: 0.4rem;
        }

        .login-title {
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.02em;
            margin-bottom: 0.3rem;
        }

        .login-subtitle {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .login-field { margin-bottom: 1.25rem; }

        .login-label {
            display: block;
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.4rem;
        }

        .login-input {
            width: 100%;
            padding: 0.65rem 1rem;
            border: 1.5px solid #e0e7ea;
            border-radius: 12px;
            background: #ffffff;
            font-size: 0.95rem;
            color: var(--text-main);
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

            .login-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 0.18rem rgba(0,91,113,0.12);
            }

            .login-input::placeholder { color: #b0b7c3; }

        .login-pw-wrap { position: relative; }

        .login-pw-toggle {
            position: absolute;
            right: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            padding: 0;
            line-height: 1;
        }

        .login-btn {
            width: 100%;
            padding: 0.75rem 1rem;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

            .login-btn:hover { opacity: 0.88; }

        .login-error {
            background: #fff5f5;
            border: 1px solid #fee2e2;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            font-size: 0.85rem;
            color: #991b1b;
            margin-bottom: 1.25rem;
        }

        .login-footer-note {
            margin-top: 1.5rem;
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* ── Mobile ── */
        @@media (max-width: 768px) {
            body { flex-direction: column; }
            .login-left {
                width: 100%;
                min-height: auto;
                padding: 2.5rem 1.5rem 2rem;
            }
            .login-logo { width: 80px; height: 80px; margin-bottom: 1.25rem; }
            .login-brand-name { font-size: 1.7rem; }
            .login-feature-list { display: none; }
            .login-right { padding: 2rem 1.25rem; }
        }
    </style>
</head>
<body>

    <!-- Left branding panel -->
    <div class="login-left">
        <img src="~/images/Logo.png" alt="Rentify Logo" class="login-logo" />
        <div class="login-brand-name">Rentify</div>
        <div class="login-brand-sub">Property Management Platform</div>

        <ul class="login-feature-list">
            <li><i class="bi bi-building-fill"></i> Occupancy & Unit Reports</li>
            <li><i class="bi bi-wrench-adjustable"></i> Maintenance Analytics</li>
            <li><i class="bi bi-credit-card-fill"></i> Payment Summaries</li>
            <li><i class="bi bi-file-earmark-pdf-fill"></i> PDF Export</li>
            <li><i class="bi bi-shield-lock-fill"></i> Property Manager Access Only</li>
        </ul>
    </div>

    <!-- Right form panel -->
    <div class="login-right">
        <div class="login-form-wrap">

            <div class="login-form-header">
                <div class="login-eyebrow">Property Manager Portal</div>
                <h1 class="login-title">Sign in to Rentify</h1>
                <p class="login-subtitle">Enter your credentials to access the reports.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="login-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Index" method="post" autocomplete="off">

                <div class="login-field">
                    <label asp-for="Email" class="login-label"></label>
                    <input asp-for="Email" type="email" class="login-input"
                           placeholder="manager@example.com" autocomplete="new-password" />
                </div>

                <div class="login-field">
                    <label asp-for="Password" class="login-label"></label>
                    <div class="login-pw-wrap">
                        <input asp-for="Password" type="password" class="login-input"
                               placeholder="••••••••" autocomplete="new-password"
                               style="padding-right:2.75rem;" id="login-pw" />
                        <button type="button" class="login-pw-toggle"
                                onclick="togglePw('login-pw','login-pw-icon')" tabindex="-1">
                            <i class="bi bi-eye" id="login-pw-icon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="login-btn">
                    Sign In <i class="bi bi-arrow-right"></i>
                </button>

            </form>

            <p class="login-footer-note">
                <i class="bi bi-shield-lock me-1"></i>
                Access restricted to Property Managers only.
            </p>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePw(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);
            input.type  = input.type === 'password' ? 'text' : 'password';
            icon.classList.toggle('bi-eye');
            icon.classList.toggle('bi-eye-slash');
        }
    </script>
</body>
</html>
