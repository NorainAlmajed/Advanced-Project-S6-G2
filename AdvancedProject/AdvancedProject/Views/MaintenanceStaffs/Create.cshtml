@model MaintenanceStaffCreateVM

@{
    ViewData["Title"] = "Create Maintenance Staff";
}

<div class="staff-form-page">
    <div class="lease-form-wrapper">
        <div class="lease-form-card shadow-soft">

            <div class="lease-form-header">
                <p class="lease-form-eyebrow mb-2">Maintenance Staff</p>
                <h1 class="lease-form-title mb-2">Create Maintenance Staff</h1>
                <p class="lease-form-subtitle mb-0">
                    Add a new staff account and assign their maintenance skills.
                </p>
            </div>

            <form asp-action="Create" method="post" class="lease-form-body" autocomplete="off">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Username" class="lease-form-label"></label>
                        <input asp-for="Username" class="form-control lease-form-input" placeholder="Enter username" autocomplete="off" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Password" class="lease-form-label"></label>
                        <input asp-for="Password" type="password" class="form-control lease-form-input" autocomplete="new-password" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="ConfirmPassword" class="lease-form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control lease-form-input" autocomplete="new-password" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="FullName" class="lease-form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control lease-form-input" placeholder="Enter full name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Email" class="lease-form-label"></label>
                        <input asp-for="Email" type="email" class="form-control lease-form-input" placeholder="Enter email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Phone" class="lease-form-label"></label>
                        <input asp-for="Phone" class="form-control lease-form-input" placeholder="Enter phone number" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label class="lease-form-label">Gender</label>

                        <div class="staff-radio-group">
                            <label class="staff-radio-card">
                                <input type="radio" asp-for="Gender" value="M" />
                                <span>Male</span>
                            </label>

                            <label class="staff-radio-card">
                                <input type="radio" asp-for="Gender" value="F" />
                                <span>Female</span>
                            </label>
                        </div>

                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                </div>

                <div class="lease-form-group mt-2">
                    <label class="lease-form-label">Skills</label>

                    <div class="staff-skills-grid">
                        @foreach (var skill in (List<AdvancedProjectAPI.Models.Skill>)ViewData["Skills"])
                        {
                            <label class="staff-skill-card">
                                <input type="checkbox"
                                       name="SelectedSkillIds"
                                       value="@skill.SkillId" />
                                <span>@skill.Name</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="lease-form-actions">
                    <button type="submit" class="ux-btn-primary">
                        Create Staff
                    </button>

                    <a asp-action="Index" class="ux-btn-ghost">
                        Back to List
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}