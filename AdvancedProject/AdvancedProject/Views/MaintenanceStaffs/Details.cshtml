@model AdvancedProjectAPI.Models.MaintenanceStaff

@{
    ViewData["Title"] = "Staff Details";

    string fullName = Model.User?.FullName ?? "Staff Member";
    string username = Model.User?.Username ?? "—";
    string email = Model.User?.Email ?? "—";
    string phone = Model.User?.Phone ?? "—";
    string role = Model.User?.Role ?? "Staff";
    string availability = string.IsNullOrWhiteSpace(Model.AvailabilityStatus) ? "Unknown" : Model.AvailabilityStatus;
    string createdAtText = Model.User != null ? Model.User.CreatedAt.ToString("dd MMM yyyy") : "—";
    string genderText = Model.User?.Gender == "F" ? "Female" : "Male";

    string availabilityClass = availability.ToLower() switch
    {
        "available" => "badge-soft-active",
        "busy" => "badge-soft-inactive",
        _ => "badge-soft-default"
    };
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Maintenance Team</p>
            <h1 class="ux-title">@fullName</h1>
            <p class="ux-subtitle">
                <i class="bi bi-at" style="color:var(--accent);"></i>@username
                <span style="margin:0 0.4rem;color:var(--text-muted);">&middot;</span>
                Maintenance Staff
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.StaffId" class="ux-btn-outline">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <a asp-controller="Users" asp-action="Index" class="ux-btn-ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="ux-details-main" style="display:flex;flex-direction:column;gap:1.25rem;">

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Staff Profile</h3>
                    <p class="ux-form-section-sub">Personal and contact details for this staff member.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Full Name</span>
                    <span class="ux-detail-value">@fullName</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Username</span>
                    <span class="ux-detail-value">@username</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Email</span>
                    <span class="ux-detail-value">@email</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Phone</span>
                    <span class="ux-detail-value">@phone</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Gender</span>
                    <span class="ux-detail-value">@genderText</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Availability</span>
                    <span class="ux-detail-value">
                        <span class="custom-pill @availabilityClass">@availability</span>
                    </span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Account Created</span>
                    <span class="ux-detail-value">@createdAtText</span>
                </div>
            </div>
        </div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                    <i class="bi bi-tools"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Skills</h3>
                    <p class="ux-form-section-sub">Technical skills assigned to this staff member.</p>
                </div>
            </div>
            @if (Model.Skills != null && Model.Skills.Any())
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @foreach (var skill in Model.Skills)
                    {
                        <span class="custom-pill badge-soft-manager">@skill.Name</span>
                    }
                </div>
            }
            else
            {
                <p class="ux-detail-value mt-3" style="color:var(--text-muted);">No skills assigned.</p>
            }
        </div>

    </div>

</div>
