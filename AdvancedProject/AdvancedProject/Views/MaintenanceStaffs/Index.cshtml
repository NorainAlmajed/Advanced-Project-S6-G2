@model IEnumerable<AdvancedProjectAPI.Models.MaintenanceStaff>
@using AdvancedProject.ViewModels

@{
    ViewData["Title"] = "Maintenance Staff";
    string currentSearch = ViewData["CurrentSearchTerm"]?.ToString() ?? "";
    string currentAvailability = ViewData["CurrentAvailabilityFilter"]?.ToString() ?? "";
    var currentSkillIds = ViewData["CurrentSkillIds"] as List<int> ?? new List<int>();
    var skillsList = ViewData["Skills"] as List<Skill> ?? new List<Skill>();
    string selectedSkillsText = currentSkillIds.Any() ? $"{currentSkillIds.Count} skill(s) selected" : "All Skills";

    int totalStaff = Model.Count();
    int available  = Model.Count(s => s.AvailabilityStatus == "Available");
    int busy       = Model.Count(s => s.AvailabilityStatus == "Busy");
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">User Management</p>
            <h1 class="ux-title">Maintenance Staff</h1>
            <p class="ux-subtitle">Browse and manage maintenance staff by availability and skill.</p>
        </div>
        <a asp-action="Create" class="ux-btn-primary">
            <i class="bi bi-tools"></i> Add Staff
        </a>
    </div>

    <div class="ux-stats-row" style="grid-template-columns: repeat(3,1fr);">
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(99,102,241,0.1);color:#6366f1;"><i class="bi bi-people-fill"></i></div>
            <div><div class="ux-stat-value">@totalStaff</div><div class="ux-stat-label">Total Staff</div></div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;"><i class="bi bi-check-circle-fill"></i></div>
            <div><div class="ux-stat-value">@available</div><div class="ux-stat-label">Available</div></div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(245,158,11,0.1);color:#d97706;"><i class="bi bi-clock-fill"></i></div>
            <div><div class="ux-stat-value">@busy</div><div class="ux-stat-label">Busy</div></div>
        </div>
    </div>

    <div class="ux-toolbar" style="flex-wrap:wrap; gap:0.75rem;">
        <form asp-action="Index" method="get" class="ux-search-form" style="flex-wrap:wrap;">
            <div class="ux-search-wrap" style="min-width:220px;">
                <i class="bi bi-search ux-search-icon"></i>
                <input type="text" name="searchTerm" value="@currentSearch"
                       class="ux-search-input" placeholder="Search by name, email..." />
            </div>

            <select name="availabilityFilter" class="ux-search-input" style="width:150px; padding:0.55rem 0.85rem; border:1.5px solid #e5e7eb; border-radius:8px; font-size:0.875rem; outline:none;">
                <option value="">All Statuses</option>
                <option value="Available" selected="@(currentAvailability == "Available")">Available</option>
                <option value="Busy" selected="@(currentAvailability == "Busy")">Busy</option>
            </select>

            <div class="dropdown">
                <button class="ux-btn-ghost dropdown-toggle" type="button" id="skillsDropdownButton"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <i class="bi bi-wrench"></i>
                    <span id="skillsDropdownText">@selectedSkillsText</span>
                </button>
                <div class="dropdown-menu p-3" style="min-width:220px; max-height:240px; overflow-y:auto;">
                    @if (skillsList.Any())
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="selectAllSkills" />
                            <label class="form-check-label fw-semibold" for="selectAllSkills">Select / Clear All</label>
                        </div>
                        <hr class="my-2" />
                        @foreach (var skill in skillsList)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input skill-checkbox" type="checkbox"
                                       name="skillIds" value="@skill.SkillId" id="skill_@skill.SkillId"
                                       @(currentSkillIds.Contains(skill.SkillId) ? "checked" : "") />
                                <label class="form-check-label" for="skill_@skill.SkillId">@skill.Name</label>
                            </div>
                        }
                    }
                    else { <span class="text-muted small">No skills available</span> }
                </div>
            </div>

            <button type="submit" class="ux-btn-primary">Search</button>
            <a asp-action="Index" class="ux-btn-ghost">Reset</a>
        </form>

        <div class="ux-filter-tabs">
            <a asp-controller="Users" asp-action="Index" class="ux-filter-tab">All Users</a>
            <a asp-controller="Tenants" asp-action="Index" class="ux-filter-tab">Tenants</a>
            <a asp-controller="MaintenanceStaffs" asp-action="Index" class="ux-filter-tab active">Staff</a>
        </div>
    </div>

    <div class="ux-table-card">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="ux-table">
                    <thead>
                        <tr>
                            <th>Staff Member</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Availability</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string initial = !string.IsNullOrEmpty(item.User?.FullName) ? item.User.FullName[0].ToString().ToUpper() : "S";
                            string availColor = item.AvailabilityStatus == "Available" ? "rgba(30,142,110,0.1)" : "rgba(245,158,11,0.1)";
                            string availText  = item.AvailabilityStatus == "Available" ? "#1E8E6E" : "#d97706";
                            <tr>
                                <td>
                                    <div class="ux-user-cell">
                                        <div class="ux-avatar" style="background:#6366f1;">@initial</div>
                                        <div>
                                            <div class="ux-user-name">@item.User?.FullName</div>
                                            <div class="ux-user-sub">@@@item.User?.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="ux-cell-muted">@item.User?.Email</td>
                                <td class="ux-cell-muted">@item.User?.Phone</td>
                                <td>
                                    <span class="ux-role-badge" style="background:@availColor; color:@availText;">
                                        @item.AvailabilityStatus
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.StaffId" class="ux-details-btn">
                                        View <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ux-empty">
                <i class="bi bi-tools"></i>
                <p>No maintenance staff found.</p>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const skillCheckboxes = document.querySelectorAll(".skill-checkbox");
            const selectAllCheckbox = document.getElementById("selectAllSkills");
            const dropdownText = document.getElementById("skillsDropdownText");
            function updateDropdownText() {
                const checked = document.querySelectorAll(".skill-checkbox:checked");
                const count = checked.length;
                if (count === 0) dropdownText.textContent = "All Skills";
                else if (count === 1) dropdownText.textContent = checked[0].closest(".form-check").querySelector("label").textContent.trim();
                else dropdownText.textContent = count + " skills selected";
                if (selectAllCheckbox) selectAllCheckbox.checked = count === skillCheckboxes.length && skillCheckboxes.length > 0;
            }
            if (selectAllCheckbox) selectAllCheckbox.addEventListener("change", () => { skillCheckboxes.forEach(cb => cb.checked = selectAllCheckbox.checked); updateDropdownText(); });
            skillCheckboxes.forEach(cb => cb.addEventListener("change", updateDropdownText));
            updateDropdownText();
        });
    </script>
}
