@model IEnumerable<AdvancedProjectAPI.Models.LeaseApplication>

@{
    ViewData["Title"] = "Lease Applications";
    var currentSearch = ViewData["CurrentSearchTerm"]?.ToString() ?? "";
    var currentStatus = ViewData["CurrentStatusFilter"]?.ToString() ?? "";
    var currentDate   = ViewData["CurrentDateFilter"]?.ToString() ?? "";
    int total    = Model.Count();
    int pending  = Model.Count(a => a.Status == "Pending");
    int approved = Model.Count(a => a.Status == "Approved");
    int rejected = Model.Count(a => a.Status == "Rejected");
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Lease Management</p>
            <h1 class="ux-title">Applications</h1>
            <p class="ux-subtitle">Review and process incoming lease applications.</p>
        </div>
    </div>

    <div class="ux-stats-row">
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(0,91,113,0.1);color:#005B71;"><i class="bi bi-file-earmark-text-fill"></i></div>
            <div><div class="ux-stat-value">@total</div><div class="ux-stat-label">Total</div></div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(245,158,11,0.1);color:#d97706;"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="ux-stat-value">@pending</div><div class="ux-stat-label">Pending</div></div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;"><i class="bi bi-check-circle-fill"></i></div>
            <div><div class="ux-stat-value">@approved</div><div class="ux-stat-label">Approved</div></div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(220,53,69,0.1);color:#b42318;"><i class="bi bi-x-circle-fill"></i></div>
            <div><div class="ux-stat-value">@rejected</div><div class="ux-stat-label">Rejected</div></div>
        </div>
    </div>

    <div class="ux-toolbar">
        <form asp-action="Index" method="get" class="ux-search-form">
            <div class="ux-search-wrap">
                <i class="bi bi-search ux-search-icon"></i>
                <input type="text" name="searchTerm" value="@currentSearch"
                       class="ux-search-input" placeholder="Search by ID, tenant, unit, property..." />
            </div>
            <select name="statusFilter" class="ux-search-input" style="width:150px;padding:0.55rem 0.85rem;border:1.5px solid #e5e7eb;border-radius:8px;font-size:0.875rem;outline:none;">
                <option value="">All Statuses</option>
                <option value="Pending"   selected="@(currentStatus=="Pending")">Pending</option>
                <option value="Approved"  selected="@(currentStatus=="Approved")">Approved</option>
                <option value="Rejected"  selected="@(currentStatus=="Rejected")">Rejected</option>
                <option value="Cancelled" selected="@(currentStatus=="Cancelled")">Cancelled</option>
            </select>
            <select name="dateFilter" class="ux-search-input" style="width:130px;padding:0.55rem 0.85rem;border:1.5px solid #e5e7eb;border-radius:8px;font-size:0.875rem;outline:none;">
                <option value="">All Dates</option>
                <option value="Latest" selected="@(currentDate=="Latest")">Latest First</option>
                <option value="Oldest" selected="@(currentDate=="Oldest")">Oldest First</option>
            </select>
            <button type="submit" class="ux-btn-primary">Search</button>
            <a asp-action="Index" class="ux-btn-ghost">Reset</a>
        </form>
    </div>

    <div class="ux-table-card">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="ux-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tenant</th>
                            <th>Unit</th>
                            <th>Applied On</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string statusColor = item.Status == "Approved" ? "#1E8E6E" : item.Status == "Rejected" ? "#b42318" : item.Status == "Cancelled" ? "#4b5563" : "#d97706";
                            string statusBg    = item.Status == "Approved" ? "rgba(30,142,110,0.1)" : item.Status == "Rejected" ? "rgba(220,53,69,0.1)" : item.Status == "Cancelled" ? "rgba(107,114,128,0.1)" : "rgba(245,158,11,0.1)";
                            string initial = item.Tenant?.User?.FullName?.Length > 0 ? item.Tenant.User.FullName[0].ToString().ToUpper() : "T";
                            <tr>
                                <td class="ux-cell-muted fw-semibold">#@item.ApplicationId</td>
                                <td>
                                    <div class="ux-user-cell">
                                        <div class="ux-avatar" style="background:#1E8E6E;">@initial</div>
                                        <div>
                                            <div class="ux-user-name">@item.Tenant?.User?.FullName</div>
                                            <div class="ux-user-sub">@item.Tenant?.User?.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="ux-user-name">@item.Unit?.UnitNumber</div>
                                    <div class="ux-user-sub">@item.Unit?.Property?.Name</div>
                                </td>
                                <td class="ux-cell-muted">@item.ApplicationDate.ToString("dd MMM yyyy")</td>
                                <td><span class="ux-role-badge" style="background:@statusBg;color:@statusColor;">@item.Status</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.ApplicationId" class="ux-details-btn">
                                        View <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ux-empty">
                <i class="bi bi-file-earmark-x"></i>
                <p>No applications found.</p>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (AdvancedProject.ViewModels.PaginationVM)ViewBag.Pagination)

</div>
