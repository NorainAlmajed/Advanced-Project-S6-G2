@model AdvancedProjectAPI.Models.LeaseApplication

@{
    ViewData["Title"] = "Application Details";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Lease Applications</p>
            <h1 class="ux-title">Application #@Model.ApplicationId</h1>
            <p class="ux-subtitle">
                <i class="bi bi-person-fill" style="color:var(--accent);margin-right:0.3rem;"></i>
                @Model.Tenant.User.FullName
                <span style="margin:0 0.4rem;color:var(--text-muted);">&middot;</span>
                <i class="bi bi-building-fill" style="color:var(--accent);margin-right:0.25rem;"></i>
                @Model.Unit.Property.Name, Unit @Model.Unit.UnitNumber
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.Status == "Pending")
            {
                @if (!User.IsInRole("Tenant"))
                {
                    <button type="button" class="ux-btn-primary" data-bs-toggle="modal" data-bs-target="#approveModal">
                        <i class="bi bi-check-circle-fill"></i> Approve
                    </button>
                    <button type="button" class="ux-btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        <i class="bi bi-x-circle-fill"></i> Reject
                    </button>
                }
                @if (User.IsInRole("Tenant"))
                {
                    <button type="button" class="ux-btn-outline" data-bs-toggle="modal" data-bs-target="#cancelApplicationModal">
                        <i class="bi bi-slash-circle"></i> Cancel Application
                    </button>
                }
            }
            <a asp-action="Index" class="ux-btn-ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="ux-details-main" style="display:flex;flex-direction:column;gap:1.25rem;">

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Application Information</h3>
                    <p class="ux-form-section-sub">Main lease application details.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Status</span>
                    <span class="ux-detail-value">
                        @if (Model.Status == "Approved")
                        {
                            <span class="custom-pill lease-status-approved">Approved</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="custom-pill lease-status-rejected">Rejected</span>
                        }
                        else
                        {
                            <span class="custom-pill lease-status-pending">Pending</span>
                        }
                    </span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Application Date</span>
                    <span class="ux-detail-value">@Model.ApplicationDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Start Date</span>
                    <span class="ux-detail-value">@Model.StartDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Duration</span>
                    <span class="ux-detail-value">@Model.Duration.Months Months</span>
                </div>
                @if (Model.ApproveTime != null)
                {
                    <div class="ux-detail-item">
                        <span class="ux-detail-label">Approved Time</span>
                        <span class="ux-detail-value">@Model.ApproveTime</span>
                    </div>
                }
                @if (Model.RejectTime != null)
                {
                    <div class="ux-detail-item">
                        <span class="ux-detail-label">Rejected Time</span>
                        <span class="ux-detail-value">@Model.RejectTime</span>
                    </div>
                }
            </div>
        </div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Tenant Screening</h3>
                    <p class="ux-form-section-sub">Important tenant information for approval review.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Full Name</span>
                    <span class="ux-detail-value">@Model.Tenant.User.FullName</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Email</span>
                    <span class="ux-detail-value">@Model.Tenant.User.Email</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Phone</span>
                    <span class="ux-detail-value">@Model.Tenant.User.Phone</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Gender</span>
                    <span class="ux-detail-value">@Model.Tenant.User.Gender</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">National ID</span>
                    <span class="ux-detail-value">@Model.Tenant.NationalId</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Date of Birth</span>
                    <span class="ux-detail-value">@Model.Tenant.Dob.ToString("dd MMM yyyy")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Employment Status</span>
                    <span class="ux-detail-value">@Model.Tenant.EmploymentStatus</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Marital Status</span>
                    <span class="ux-detail-value">@Model.Tenant.MaritalStatus</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Salary</span>
                    <span class="ux-detail-value">BD @Model.Tenant.Salary</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Financial Stability</span>
                    <span class="ux-detail-value">@Model.Tenant.FinancialStability</span>
                </div>
            </div>
        </div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(234,88,12,0.1);color:#EA580C;">
                    <i class="bi bi-building-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Requested Unit</h3>
                    <p class="ux-form-section-sub">Property and unit information.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Property</span>
                    <span class="ux-detail-value">@Model.Unit.Property.Name</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Unit Number</span>
                    <span class="ux-detail-value">@Model.Unit.UnitNumber</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Unit Type</span>
                    <span class="ux-detail-value">@(Model.Unit.UnitType?.Name ?? "—")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Monthly Rent</span>
                    <span class="ux-detail-value">BD @Model.Unit.RentAmount</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Size</span>
                    <span class="ux-detail-value">@Model.Unit.SizeSqFt Sq Ft</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">City</span>
                    <span class="ux-detail-value">@Model.Unit.Property.City</span>
                </div>
            </div>
        </div>

    </div>

</div>

@if (Model.Status == "Pending" && User.IsInRole("Tenant"))
{
    <div class="modal fade" id="cancelApplicationModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Cancel Application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to cancel this lease application?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Back</button>
                    <form asp-action="CancelApplication" asp-route-id="@Model.ApplicationId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ux-btn-outline">Confirm Cancellation</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Status == "Pending")
{
    <div class="modal fade" id="approveModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Approve Application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to approve this lease application?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Approve" asp-route-id="@Model.ApplicationId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ux-btn-primary">Confirm Approval</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Reject Application</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to reject this lease application?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Reject" asp-route-id="@Model.ApplicationId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ux-btn-danger">Confirm Rejection</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
