@model AdvancedProject.Models.Lease

@{
    ViewData["Title"] = "Lease Details";
}

<div class="lease-details-page">

    <div class="lease-details-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <p class="lease-eyebrow mb-2">LEASE DETAILS</p>
            <h1 class="lease-title mb-2">
                Lease #@Model.LeaseId
            </h1>
            <p class="lease-subtitle mb-0">
                View lease information and tenant details.
            </p>
        </div>

       
    </div>

    <div class="lease-details-card">

        <div class="section-header">
            <h3>Lease Information</h3>
            <p>Main lease details and rental information.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">TENANT</div>
                    <div class="info-value">
                        @Model.Tenant.User.FullName
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">PROPERTY</div>
                    <div class="info-value">
                        @Model.Unit.Property.Name
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">UNIT NUMBER</div>
                    <div class="info-value">
                        @Model.Unit.UnitNumber
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">DURATION</div>
                    <div class="info-value">
                        @Model.Duration.Months Months
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">START DATE</div>
                    <div class="info-value">
                        @Model.StartDate.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">END DATE</div>
                    <div class="info-value">
                        @Model.EndDate.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">MONTHLY RENT</div>
                    <div class="info-value">
                        BD @Model.MonthlyRent.ToString("0.00")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">STATUS</div>

                    <div class="info-value">
                        @if (Model.Status == "Active")
                        {
                            <span class="custom-pill lease-status-active">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="custom-pill lease-status-inactive">
                                @Model.Status
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">CREATED AT</div>
                    <div class="info-value">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

        </div>

        <div class="mt-4 d-flex gap-3 flex-wrap">
            <a asp-action="Edit"
               asp-route-id="@Model.LeaseId"
               class="btn btn-success lease-action-btn">
                Edit Lease
            </a>

            <a asp-action="Index"
               class="btn btn-light-custom lease-action-btn">
                Back to List
            </a>
        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}