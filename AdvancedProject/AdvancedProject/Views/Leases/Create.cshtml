@model AdvancedProjectAPI.Models.Lease

@{
    ViewData["Title"] = "Create Lease";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Lease Management</p>
            <h1 class="ux-title">Create Lease</h1>
            <p class="ux-subtitle">@ViewBag.PropertyName — Unit @ViewBag.UnitNumber</p>
        </div>
        <a asp-action="Index" class="ux-btn-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    <form asp-action="Create" asp-controller="Leases" method="post" class="ux-form-layout">
        <input type="hidden" name="UnitId" value="@Model.UnitId" />
        <div asp-validation-summary="ModelOnly" class="ux-form-error"></div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;"><i class="bi bi-file-earmark-check-fill"></i></div>
                <div><h3 class="ux-form-section-title">Lease Details</h3><p class="ux-form-section-sub">Select tenant, start date, and duration.</p></div>
            </div>
            <div class="ux-form-grid">
                <div class="ux-field" style="grid-column:1/-1;">
                    <label asp-for="TenantId" class="ux-label">Tenant</label>
                    <select asp-for="TenantId" id="tenantSelect" class="ux-input" asp-items="ViewBag.TenantName">
                        <option value="">-- Select Tenant --</option>
                    </select>
                    <span asp-validation-for="TenantId" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="StartDate" class="ux-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="ux-input"
                           min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="StartDate" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="DurationId" class="ux-label">Duration</label>
                    <select asp-for="DurationId" class="ux-input" asp-items="ViewBag.DurationId">
                        <option value="">-- Select Duration --</option>
                    </select>
                    <span asp-validation-for="DurationId" class="ux-field-error"></span>
                </div>
            </div>
        </div>

        <div class="ux-form-actions">
            <button type="submit" class="ux-btn-primary" style="padding:0.65rem 2rem;">
                <i class="bi bi-file-earmark-plus"></i> Create Lease
            </button>
            <a asp-action="Index" class="ux-btn-ghost" style="padding:0.65rem 1.5rem;">Cancel</a>
        </div>
    </form>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tenantSelect = document.getElementById("tenantSelect");
            if (tenantSelect) {
                new Choices(tenantSelect, {
                    searchEnabled: true, itemSelectText: '', shouldSort: false,
                    searchPlaceholderValue: 'Search tenant...', placeholder: true,
                    classNames: { containerOuter: 'choices ux-choices' }
                });
            }
        });
    </script>
}
