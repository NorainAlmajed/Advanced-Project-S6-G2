@model AdvancedProjectAPI.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Edit Maintenance Request";
}

<div class="maintenance-request-form-page">
    <div class="lease-form-wrapper">
        <div class="lease-form-card shadow-soft">

            <div class="lease-form-header">
                <p class="lease-form-eyebrow mb-2">Maintenance Request</p>
                <h1 class="lease-form-title mb-2">Edit Request</h1>
                <p class="lease-form-subtitle mb-0">
                    Update the unit, maintenance type, priority, and description.
                </p>
            </div>

            <form asp-action="EditTenant" method="post" class="lease-form-body">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="RequestId" />

                <div class="lease-form-group">
                    <label asp-for="UnitId" class="lease-form-label">Unit Number</label>
                    <select asp-for="UnitId" class="form-control lease-form-input" asp-items="ViewBag.UnitId"></select>
                    <span asp-validation-for="UnitId" class="text-danger"></span>
                </div>

                <div class="lease-form-group">
                    <label asp-for="SkillId" class="lease-form-label">Maintenance Type</label>
                    <select asp-for="SkillId" class="form-control lease-form-input" asp-items="ViewBag.SkillId"></select>
                    <span asp-validation-for="SkillId" class="text-danger"></span>
                </div>

                <div class="lease-form-group">
                    <label asp-for="Priority" class="lease-form-label"></label>
                    <select asp-for="Priority" class="form-control lease-form-input">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>

                <div class="lease-form-group">
                    <label asp-for="Notes" class="lease-form-label">Description</label>
                    <textarea asp-for="Notes"
                              class="form-control lease-form-input maintenance-notes-input"
                              placeholder="Describe the issue..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="lease-form-actions">
                    <button type="submit" class="ux-btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index" class="ux-btn-ghost">
                        Back to List
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}