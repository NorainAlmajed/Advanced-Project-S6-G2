@model AdvancedProjectAPI.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Create Maintenance Request";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Maintenance</p>
            <h1 class="ux-title">New Request</h1>
            <p class="ux-subtitle">Select your unit, request type, priority, and describe the issue.</p>
        </div>
        <a asp-action="Index" class="ux-btn-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    @if (ViewBag.HasActiveLease == false)
    {
        <div class="ux-form-card" style="text-align:center;padding:2.5rem;">
            <div style="color:#d97706;font-size:2rem;margin-bottom:0.75rem;"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <h3 style="font-size:1rem;font-weight:700;color:var(--text-main);margin-bottom:0.35rem;">No Active Lease</h3>
            <p style="font-size:0.875rem;color:var(--text-muted);margin-bottom:1.25rem;">You cannot create a maintenance request because you do not have any active lease units.</p>
            <a asp-action="Index" class="ux-btn-ghost">Back to List</a>
        </div>
    }
    else
    {
        <form asp-action="Create" method="post" class="ux-form-layout">
            <div asp-validation-summary="ModelOnly" class="ux-form-error"></div>

            <div class="ux-form-card">
                <div class="ux-form-section-header">
                    <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;"><i class="bi bi-wrench-adjustable"></i></div>
                    <div><h3 class="ux-form-section-title">Request Details</h3><p class="ux-form-section-sub">Specify the unit, type, and priority.</p></div>
                </div>
                <div class="ux-form-grid">
                    <div class="ux-field">
                        <label asp-for="UnitId" class="ux-label">Unit</label>
                        <select asp-for="UnitId" class="ux-input" asp-items="ViewBag.UnitId" id="unitSearchDropdown">
                            <option value="">-- Select Unit --</option>
                        </select>
                        <span asp-validation-for="UnitId" class="ux-field-error"></span>
                    </div>
                    <div class="ux-field">
                        <label asp-for="SkillId" class="ux-label">Request Type</label>
                        <select asp-for="SkillId" class="ux-input" asp-items="ViewBag.SkillId">
                            <option value="">-- Select Type --</option>
                        </select>
                        <span asp-validation-for="SkillId" class="ux-field-error"></span>
                    </div>
                    <div class="ux-field">
                        <label asp-for="Priority" class="ux-label">Priority</label>
                        <select asp-for="Priority" class="ux-input">
                            <option value="">-- Select Priority --</option>
                            <option>Low</option>
                            <option>Medium</option>
                            <option>High</option>
                        </select>
                        <span asp-validation-for="Priority" class="ux-field-error"></span>
                    </div>
                    <div class="ux-field" style="grid-column:1/-1;">
                        <label asp-for="Notes" class="ux-label">Description</label>
                        <textarea asp-for="Notes" class="ux-input" placeholder="Describe the issue in detail..." style="min-height:100px;resize:vertical;"></textarea>
                        <span asp-validation-for="Notes" class="ux-field-error"></span>
                    </div>
                </div>
            </div>

            <div class="ux-form-actions">
                <button type="submit" class="ux-btn-primary" style="padding:0.65rem 2rem;">
                    <i class="bi bi-send-fill"></i> Submit Request
                </button>
                <a asp-action="Index" class="ux-btn-ghost" style="padding:0.65rem 1.5rem;">Cancel</a>
            </div>
        </form>
    }

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const unitDropdown = document.getElementById('unitSearchDropdown');
            if (unitDropdown) {
                new Choices(unitDropdown, {
                    searchEnabled: true, itemSelectText: '', shouldSort: false,
                    placeholder: true, searchPlaceholderValue: 'Search unit...',
                    classNames: { containerOuter: 'choices ux-choices' }
                });
            }
        });
    </script>
}
