@model AdvancedProject.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Create Maintenance Request";
}

<div class="maintenance-request-form-page">
    <div class="lease-form-wrapper">
        <div class="lease-form-card shadow-soft">

            <div class="lease-form-header">
                <p class="lease-form-eyebrow mb-2">Maintenance Request</p>
                <h1 class="lease-form-title mb-2">Create Request</h1>
                <p class="lease-form-subtitle mb-0">
                    Select your unit, request type, priority, and describe the issue.
                </p>
            </div>

            <div class="lease-form-body">

                @if (ViewBag.HasActiveLease == false)
                {
                    <div class="alert alert-warning maintenance-request-warning mb-0">
                        You cannot create a maintenance request because you do not have any active lease units.
                    </div>

                    <div class="lease-form-actions">
                        <a asp-action="Index" class="lease-back-link">Back to List</a>
                    </div>
                }
                else
                {
                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="lease-form-group">
                            <label asp-for="UnitId" class="lease-form-label">Unit Number</label>
                            <select asp-for="UnitId"
                                    class="form-control lease-form-input"
                                    asp-items="ViewBag.UnitId"
                                    id="unitSearchDropdown">
                                <option value="">-- Select Unit --</option>
                            </select>
                            <span asp-validation-for="UnitId" class="text-danger"></span>
                        </div>

                        <div class="lease-form-group">
                            <label asp-for="SkillId" class="lease-form-label">Request Type</label>
                            <select asp-for="SkillId"
                                    class="form-control lease-form-input"
                                    asp-items="ViewBag.SkillId">
                                <option value="">-- Select Type --</option>
                            </select>
                            <span asp-validation-for="SkillId" class="text-danger"></span>
                        </div>

                        <div class="lease-form-group">
                            <label asp-for="Priority" class="lease-form-label">Priority</label>
                            <select asp-for="Priority" class="form-control lease-form-input">
                                <option value="">-- Select Priority --</option>
                                <option>Low</option>
                                <option>Medium</option>
                                <option>High</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>

                        <div class="lease-form-group">
                            <label asp-for="Notes" class="lease-form-label">Notes</label>
                            <textarea asp-for="Notes"
                                      class="form-control lease-form-input maintenance-notes-input"
                                      placeholder="Describe the issue..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="lease-form-actions">
                            <button type="submit" class="btn btn-primary lease-submit-btn">
                                Create Request
                            </button>

                            <a asp-action="Index" class="lease-back-link">
                                Back to List
                            </a>
                        </div>

                    </form>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const unitDropdown = document.getElementById('unitSearchDropdown');

            if (unitDropdown) {
                new Choices(unitDropdown, {
                    searchEnabled: true,
                    itemSelectText: '',
                    shouldSort: false,
                    placeholder: true,
                    searchPlaceholderValue: 'Search unit number...'
                });
            }
        });
    </script>
}