@model AdvancedProject.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Maintenance Request Details";
}

<div class="lease-details-page">

    <div class="lease-details-header mb-4">
        <div>
            <p class="lease-eyebrow mb-2">MAINTENANCE REQUEST</p>

            <h1 class="lease-title mb-2">
                Request #@Model.RequestId
            </h1>

            <p class="lease-subtitle mb-0">
                View request details, tenant information, assigned staff, and unit information.
            </p>
        </div>
    </div>

    <div class="lease-details-card">

        <div class="section-header">
            <h3>Request Information</h3>
            <p>Main maintenance request details and assignment information.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">REQUEST DATE</div>
                    <div class="info-value">
                        @Model.RequestDate.ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">PRIORITY</div>
                    <div class="info-value">
                        @Model.Priority
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">STATUS</div>
                    <div class="info-value">
                        @Model.Status
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">SKILL</div>
                    <div class="info-value">
                        @Model.Skill?.Name
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="info-box">
                    <div class="info-label">DESCRIPTION</div>
                    <div class="info-value">
                        @Model.Notes
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">USERNAME</div>
                    <div class="info-value">
                        @Model.User?.Username
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">USER ID</div>
                    <div class="info-value">
                        @Model.UserId
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">ASSIGNED STAFF</div>
                    <div class="info-value">
                        @(Model.AssignedStaff?.User?.FullName ?? "Not assigned")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">UNIT NUMBER</div>
                    <div class="info-value">
                        @Model.Unit?.UnitNumber
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">PROPERTY</div>
                    <div class="info-value">
                        @Model.Unit?.Property?.Name
                    </div>
                </div>
            </div>

        </div>

        <div class="mt-4 d-flex gap-3 flex-wrap">

            <a asp-action="Edit"
               asp-route-id="@Model.RequestId"
               class="btn btn-success lease-action-btn">
                Edit Request
            </a>

            <a asp-action="Index"
               class="btn btn-light-custom lease-action-btn">
                Back to List
            </a>

        </div>

    </div>

</div>