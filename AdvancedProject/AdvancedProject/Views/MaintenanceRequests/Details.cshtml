@model AdvancedProjectAPI.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Maintenance Request Details";
    bool isManager = User.IsInRole("PropertyManager");
    bool isStaff   = User.IsInRole("MaintenanceStaff");
    bool isTenant  = !isManager && !isStaff;
    string status  = Model.Status ?? "";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Maintenance Requests</p>
            <h1 class="ux-title">Request #@Model.RequestId</h1>
            <p class="ux-subtitle">
                <i class="bi bi-calendar-event-fill" style="color:var(--accent);margin-right:0.3rem;"></i>
                @Model.RequestDate.ToString("dd MMM yyyy")
                <span style="margin:0 0.4rem;color:var(--text-muted);">&middot;</span>
                @Model.Priority Priority
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">

            @if (status == "Pending")
            {
                @if (isManager)
                {
                    <a asp-action="Edit" asp-route-id="@Model.RequestId" class="ux-btn-outline">
                        <i class="bi bi-pencil-fill"></i> Edit
                    </a>
                }
                else if (isTenant)
                {
                    <a asp-action="EditTenant" asp-route-id="@Model.RequestId" class="ux-btn-outline">
                        <i class="bi bi-pencil-fill"></i> Edit
                    </a>
                }

                @if (isManager || isTenant)
                {
                    <button type="button" class="ux-btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                        <i class="bi bi-x-circle-fill"></i> Cancel Request
                    </button>
                }

                @if (isManager || isStaff)
                {
                    <button type="button" class="ux-btn-primary" data-bs-toggle="modal" data-bs-target="#inProgressModal">
                        <i class="bi bi-play-circle-fill"></i> Mark In Progress
                    </button>
                }
            }

            @if (status == "In Progress")
            {
                @if (isManager)
                {
                    <a asp-action="Edit" asp-route-id="@Model.RequestId" class="ux-btn-outline">
                        <i class="bi bi-pencil-fill"></i> Edit
                    </a>
                }
                @if (isManager || isStaff)
                {
                    <button type="button" class="ux-btn-primary" data-bs-toggle="modal" data-bs-target="#resolvedModal">
                        <i class="bi bi-check-circle-fill"></i> Mark as Resolved
                    </button>
                }
            }

            @if (status == "Resolved")
            {
                @if (isManager || isStaff)
                {
                    <button type="button" class="ux-btn-outline" data-bs-toggle="modal" data-bs-target="#closedModal">
                        <i class="bi bi-lock-fill"></i> Mark as Closed
                    </button>
                }
            }

            <a asp-action="Index" class="ux-btn-ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>

        </div>
    </div>

    <div class="ux-details-main" style="display:flex;flex-direction:column;gap:1.25rem;">

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-tools"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Request Information</h3>
                    <p class="ux-form-section-sub">Main maintenance request details.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Status</span>
                    <span class="ux-detail-value">
                        @if (status == "Pending")
                        {
                            <span class="custom-pill lease-status-pending">Pending</span>
                        }
                        else if (status == "In Progress")
                        {
                            <span class="custom-pill badge-soft-active">In Progress</span>
                        }
                        else if (status == "Resolved")
                        {
                            <span class="custom-pill lease-status-approved">Resolved</span>
                        }
                        else if (status == "Cancelled")
                        {
                            <span class="custom-pill lease-status-rejected">Cancelled</span>
                        }
                        else if (status == "Closed")
                        {
                            <span class="custom-pill badge-soft-default">Closed</span>
                        }
                        else
                        {
                            <span class="custom-pill badge-soft-default">@status</span>
                        }
                    </span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Request Date</span>
                    <span class="ux-detail-value">@Model.RequestDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Priority</span>
                    <span class="ux-detail-value">@Model.Priority</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Skill Required</span>
                    <span class="ux-detail-value">@(Model.Skill?.Name ?? "—")</span>
                </div>
                <div class="ux-detail-item" style="grid-column:1/-1;">
                    <span class="ux-detail-label">Description</span>
                    <span class="ux-detail-value">@Model.Notes</span>
                </div>
            </div>
        </div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Assignment & Location</h3>
                    <p class="ux-form-section-sub">Submitter, assigned staff, unit, and property details.</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.User?.Phone))
            {
                <div style="display:flex;align-items:center;gap:0.9rem;background:rgba(0,91,113,0.05);border:1.5px solid rgba(0,91,113,0.15);border-radius:12px;padding:0.85rem 1.1rem;margin-bottom:1.1rem;">
                    <div style="width:38px;height:38px;border-radius:10px;background:rgba(0,91,113,0.1);color:#005B71;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <div style="font-size:0.7rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:0.15rem;">
                            Lookup Phone Number
                        </div>
                        <div style="font-size:1.05rem;font-weight:800;color:#005B71;letter-spacing:0.03em;font-family:monospace;">
                            @Model.User.Phone
                        </div>
                        <div style="font-size:0.72rem;color:var(--text-muted);margin-top:0.1rem;">
                            Use this number on the public lookup page to track this request
                        </div>
                    </div>
                </div>
            }
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Submitted By</span>
                    <span class="ux-detail-value">@(Model.User?.Username ?? "—")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Assigned Staff</span>
                    <span class="ux-detail-value">@(Model.AssignedStaff?.User?.FullName ?? "Not assigned")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Unit Number</span>
                    <span class="ux-detail-value">@(Model.Unit?.UnitNumber ?? "—")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Property</span>
                    <span class="ux-detail-value">@(Model.Unit?.Property?.Name ?? "—")</span>
                </div>
            </div>
        </div>

    </div>

</div>

@if (status == "Pending" && (isManager || isTenant))
{
    <div class="modal fade" id="cancelModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Cancel Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to cancel this maintenance request?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="MarkCancelled" asp-route-id="@Model.RequestId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ux-btn-danger">Confirm Cancellation</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (status == "Pending" && (isManager || isStaff))
{
    <div class="modal fade" id="inProgressModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Mark as In Progress</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to mark this request as in progress?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="MarkInProgress" asp-route-id="@Model.RequestId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ux-btn-primary">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (status == "In Progress" && (isManager || isStaff))
{
    <div class="modal fade" id="resolvedModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Mark as Resolved</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to mark this request as resolved?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="MarkResolved" asp-route-id="@Model.RequestId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ux-btn-primary">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (status == "Resolved" && (isManager || isStaff))
{
    <div class="modal fade" id="closedModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Mark as Closed</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to close this maintenance request?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="MarkClosed" asp-route-id="@Model.RequestId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ux-btn-outline">Confirm</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
