@model IEnumerable<AdvancedProjectAPI.Models.MaintenanceRequest>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Maintenance Requests";
    var currentSearch   = ViewBag.SearchTerm as string ?? "";
    var currentPriority = ViewBag.PriorityFilter as string ?? "";
    var currentStatus   = ViewBag.StatusFilter as string ?? "";
    int total      = Model?.Count() ?? 0;
    int pending    = Model?.Count(m => m.Status == "Pending") ?? 0;
    int inProgress = Model?.Count(m => m.Status == "In Progress") ?? 0;
    int resolved   = Model?.Count(m => m.Status == "Resolved") ?? 0;
    int closed     = Model?.Count(m => m.Status == "Closed" || m.Status == "Cancelled") ?? 0;
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Maintenance Board</p>
            <h1 class="ux-title">Maintenance Requests</h1>
            <p class="ux-subtitle">Browse and manage submitted maintenance requests.</p>
        </div>
        @if (!User.IsInRole("MaintenanceStaff"))
        {
            <a asp-action="Create" class="ux-btn-primary">
                <i class="bi bi-plus-lg"></i> New Request
            </a>
        }
    </div>

    <div class="ux-stats-row">
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                <i class="bi bi-tools"></i>
            </div>
            <div>
                <div class="ux-stat-value">@total</div>
                <div class="ux-stat-label">Total Requests</div>
            </div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(245,158,11,0.1);color:#d97706;">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <div class="ux-stat-value">@pending</div>
                <div class="ux-stat-label">Pending</div>
            </div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(59,130,246,0.1);color:#2563eb;">
                <i class="bi bi-play-circle-fill"></i>
            </div>
            <div>
                <div class="ux-stat-value">@inProgress</div>
                <div class="ux-stat-label">In Progress</div>
            </div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <div class="ux-stat-value">@resolved</div>
                <div class="ux-stat-label">Resolved</div>
            </div>
        </div>
    </div>

    <div class="ux-toolbar">
        <form asp-action="Index" method="get" class="ux-search-form">
            <div class="ux-search-wrap">
                <i class="bi bi-search ux-search-icon"></i>
                <input type="text" name="searchTerm" value="@currentSearch"
                       class="ux-search-input" placeholder="Search by ID, type, or phone..." />
            </div>
            <select name="priorityFilter" class="ux-search-input" style="width:140px;padding:0.55rem 0.85rem;border:1.5px solid #e5e7eb;border-radius:8px;font-size:0.875rem;outline:none;">
                <option value="">All Priorities</option>
                <option value="High"   selected="@(currentPriority=="High")">High</option>
                <option value="Medium" selected="@(currentPriority=="Medium")">Medium</option>
                <option value="Low"    selected="@(currentPriority=="Low")">Low</option>
            </select>
            <select name="statusFilter" class="ux-search-input" style="width:150px;padding:0.55rem 0.85rem;border:1.5px solid #e5e7eb;border-radius:8px;font-size:0.875rem;outline:none;">
                <option value="">All Statuses</option>
                <option value="Pending"     selected="@(currentStatus=="Pending")">Pending</option>
                <option value="In Progress" selected="@(currentStatus=="In Progress")">In Progress</option>
                <option value="Resolved"    selected="@(currentStatus=="Resolved")">Resolved</option>
                <option value="Closed"      selected="@(currentStatus=="Closed")">Closed</option>
                <option value="Cancelled"   selected="@(currentStatus=="Cancelled")">Cancelled</option>
            </select>
            <button type="submit" class="ux-btn-primary">Search</button>
            <a asp-action="Index" class="ux-btn-ghost">Reset</a>
        </form>
        <div class="ux-stat-label" style="color:var(--text-muted);font-size:0.8rem;">@total request(s)</div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="mreq-grid">
            @foreach (var item in Model)
            {
                string priorityBorderColor = item.Priority switch
                {
                    "High"   => "#dc3545",
                    "Medium" => "#f59e0b",
                    "Low"    => "#1E8E6E",
                    _        => "#e5e7eb"
                };
                string priorityColor = item.Priority switch
                {
                    "High"   => "#b42318",
                    "Medium" => "#b45309",
                    "Low"    => "#1E8E6E",
                    _        => "#6b7280"
                };
                string priorityBg = item.Priority switch
                {
                    "High"   => "rgba(220,53,69,0.1)",
                    "Medium" => "rgba(245,158,11,0.12)",
                    "Low"    => "rgba(30,142,110,0.1)",
                    _        => "rgba(107,114,128,0.1)"
                };
                string statusColor = item.Status switch
                {
                    "Pending"     => "#b45309",
                    "In Progress" => "#2563eb",
                    "Resolved"    => "#1E8E6E",
                    "Closed"      => "#4b5563",
                    "Cancelled"   => "#c2410c",
                    _             => "#6b7280"
                };
                string statusBg = item.Status switch
                {
                    "Pending"     => "rgba(245,158,11,0.12)",
                    "In Progress" => "rgba(59,130,246,0.1)",
                    "Resolved"    => "rgba(30,142,110,0.1)",
                    "Closed"      => "rgba(75,85,99,0.1)",
                    "Cancelled"   => "rgba(234,88,12,0.1)",
                    _             => "rgba(107,114,128,0.1)"
                };

                <div class="mreq-card" style="border-left-color:@priorityBorderColor;">
                    <div class="mreq-card-top">
                        <span class="mreq-id">#@item.RequestId</span>
                        <span class="mreq-date">@item.RequestDate.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="mreq-pills">
                        <span class="ux-role-badge" style="background:@priorityBg;color:@priorityColor;">@item.Priority</span>
                        <span class="ux-role-badge" style="background:@statusBg;color:@statusColor;">@item.Status</span>
                    </div>

                    <div class="mreq-type-block">
                        <span class="mreq-type-label">TYPE</span>
                        <span class="mreq-type-value">@(item.Skill?.Name ?? "—")</span>
                    </div>

                    <div class="mreq-meta">
                        <div class="mreq-meta-item">
                            <span class="mreq-meta-label">Submitted By</span>
                            <span class="mreq-meta-value">@(item.User?.Username ?? "—")</span>
                        </div>
                        <div class="mreq-meta-item">
                            <span class="mreq-meta-label">Unit</span>
                            <span class="mreq-meta-value">@(item.Unit?.UnitNumber ?? "—") <span style="color:var(--text-muted);font-weight:500;">@(item.Unit?.Property?.Name != null ? "· " + item.Unit.Property.Name : "")</span></span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.User?.Phone))
                        {
                            <div class="mreq-meta-item" style="grid-column:1/-1;">
                                <span class="mreq-meta-label">Lookup Phone</span>
                                <span class="mreq-meta-value" style="display:inline-flex;align-items:center;gap:0.4rem;">
                                    <span style="background:rgba(0,91,113,0.08);color:#005B71;border-radius:6px;padding:0.15rem 0.55rem;font-size:0.82rem;font-weight:700;letter-spacing:0.02em;font-family:monospace;">
                                        <i class="bi bi-telephone-fill" style="font-size:0.75rem;margin-right:0.25rem;"></i>@item.User.Phone
                                    </span>
                                </span>
                            </div>
                        }
                    </div>

                    <div class="mreq-card-footer">
                        <a asp-action="Details" asp-route-id="@item.RequestId" class="ux-details-btn mreq-view-btn">
                            View Details <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="ux-table-card">
            <div class="ux-empty">
                <i class="bi bi-tools"></i>
                <p>No maintenance requests found.</p>
            </div>
        </div>
    }

</div>

@section Scripts {
<script>
(function () {
    var banner = document.createElement('div');
    banner.id = 'board-live-banner';
    banner.style.cssText =
        'display:none;position:sticky;top:0;z-index:200;background:#4f46e5;color:#fff;' +
        'padding:0.7rem 1.2rem;border-radius:10px;margin-bottom:1rem;' +
        'align-items:center;gap:1rem;font-size:0.875rem;font-weight:600;flex-wrap:wrap;';
    banner.innerHTML =
        '<i class="bi bi-arrow-clockwise"></i>' +
        '<span id="board-live-msg">The board has been updated.</span>' +
        '<button onclick="location.reload()" ' +
            'style="background:rgba(255,255,255,0.2);border:none;color:#fff;' +
            'padding:0.3rem 0.85rem;border-radius:6px;cursor:pointer;font-weight:600;">' +
            'Refresh' +
        '</button>' +
        '<button onclick="document.getElementById(\'board-live-banner\').style.display=\'none\'" ' +
            'style="background:none;border:none;color:rgba(255,255,255,0.7);' +
            'font-size:1rem;cursor:pointer;margin-left:auto;">' +
            '<i class="bi bi-x-lg"></i>' +
        '</button>';

    var page = document.querySelector('.ux-page');
    if (page) page.insertBefore(banner, page.firstChild);

    var connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/maintenance-board')
        .withAutomaticReconnect()
        .build();

    connection.on('BoardUpdated', function (data) {
        var msg = document.getElementById('board-live-msg');
        if (data.eventType === 'created') {
            msg.textContent = 'A new maintenance request (#' + data.requestId + ') was submitted.';
        } else {
            msg.textContent = 'Request #' + data.requestId + ' was updated — status: ' + data.status + '.';
        }
        banner.style.display = 'flex';
    });

    connection.start().catch(function (err) {
        console.error('MaintenanceBoardHub error:', err);
    });
})();
</script>
}
