@model AdvancedProjectAPI.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Delete Maintenance Request";
}

<div class="lease-details-page">

    <div class="lease-details-header mb-4">
        <p class="lease-eyebrow mb-2">DELETE REQUEST</p>
        <h1 class="lease-title mb-2">Request #@Model.RequestId</h1>
        <p class="lease-subtitle mb-0">
            Are you sure you want to delete this maintenance request?
        </p>
    </div>

    <div class="lease-details-card">

        <div class="section-header">
            <h3>Request Information</h3>
            <p>Review the request before deleting it.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">REQUEST DATE</div>
                    <div class="info-value">@Model.RequestDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">PRIORITY</div>
                    <div class="info-value">@Model.Priority</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">STATUS</div>
                    <div class="info-value">@Model.Status</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">SKILL</div>
                    <div class="info-value">@Model.Skill?.Name</div>
                </div>
            </div>

            <div class="col-12">
                <div class="info-box">
                    <div class="info-label">DESCRIPTION</div>
                    <div class="info-value">@Model.Notes</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">USERNAME</div>
                    <div class="info-value">@Model.User?.Username</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">USER ID</div>
                    <div class="info-value">@Model.UserId</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">ASSIGNED STAFF</div>
                    <div class="info-value">
                        @(Model.AssignedStaff?.User?.FullName ?? "Not assigned")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">UNIT NUMBER</div>
                    <div class="info-value">@Model.Unit?.UnitNumber</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">PROPERTY</div>
                    <div class="info-value">@Model.Unit?.Property?.Name</div>
                </div>
            </div>

        </div>

        <form asp-action="Delete" method="post" class="mt-4 d-flex gap-3 flex-wrap">
            <input type="hidden" asp-for="RequestId" />

            <button type="submit" class="btn btn-danger lease-action-btn">
                Delete Request
            </button>

            <a asp-action="Index" class="btn btn-light-custom lease-action-btn">
                Back to List
            </a>
        </form>

    </div>

</div>