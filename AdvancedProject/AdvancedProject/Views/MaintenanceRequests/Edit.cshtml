@model AdvancedProjectAPI.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Edit Maintenance Request";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Maintenance</p>
            <h1 class="ux-title">Edit Request #@Model.RequestId</h1>
            <p class="ux-subtitle">Update request details, priority, assigned staff, and description.</p>
        </div>
        <a asp-action="Index" class="ux-btn-ghost"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    <form asp-action="Edit" method="post" class="ux-form-layout">
        <input type="hidden" asp-for="RequestId" />
        <div asp-validation-summary="ModelOnly" class="ux-form-error"></div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;"><i class="bi bi-wrench-adjustable"></i></div>
                <div><h3 class="ux-form-section-title">Request Details</h3><p class="ux-form-section-sub">Update type, priority, and assigned staff.</p></div>
            </div>
            <div class="ux-form-grid">
                <div class="ux-field">
                    <label asp-for="UnitId" class="ux-label">Unit</label>
                    <select asp-for="UnitId" class="ux-input" asp-items="ViewBag.UnitId"></select>
                    <span asp-validation-for="UnitId" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="SkillId" class="ux-label">Maintenance Type</label>
                    <select asp-for="SkillId" class="ux-input" asp-items="ViewBag.SkillId"></select>
                    <span asp-validation-for="SkillId" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="Priority" class="ux-label">Priority</label>
                    <select asp-for="Priority" class="ux-input">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                    <span asp-validation-for="Priority" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="AssignedStaffId" class="ux-label">Assigned Staff</label>
                    <select asp-for="AssignedStaffId" class="ux-input searchable-dropdown" asp-items="ViewBag.AssignedStaffId"></select>
                    <span asp-validation-for="AssignedStaffId" class="ux-field-error"></span>
                </div>
                <div class="ux-field" style="grid-column:1/-1;">
                    <label asp-for="Notes" class="ux-label">Description</label>
                    <textarea asp-for="Notes" class="ux-input" placeholder="Describe the issue..." style="min-height:100px;resize:vertical;"></textarea>
                    <span asp-validation-for="Notes" class="ux-field-error"></span>
                </div>
            </div>
        </div>

        <div class="ux-form-actions">
            <button type="submit" class="ux-btn-primary" style="padding:0.65rem 2rem;">
                <i class="bi bi-check-lg"></i> Save Changes
            </button>
            <a asp-action="Index" class="ux-btn-ghost" style="padding:0.65rem 1.5rem;">Cancel</a>
        </div>
    </form>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const staffDropdown = document.querySelector('.searchable-dropdown');
            if (staffDropdown) {
                new Choices(staffDropdown, {
                    searchEnabled: true, itemSelectText: '', shouldSort: false,
                    placeholder: true, searchPlaceholderValue: 'Search staff...',
                    classNames: { containerOuter: 'choices ux-choices' }
                });
            }
        });
    </script>
}
