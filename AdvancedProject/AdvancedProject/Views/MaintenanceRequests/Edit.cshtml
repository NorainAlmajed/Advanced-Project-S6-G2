@model AdvancedProjectAPI.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Edit Maintenance Request";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <a asp-action="Index" class="ux-btn-ghost" style="margin-bottom:0.5rem;display:inline-flex;align-items:center;gap:0.3rem;"><i class="bi bi-arrow-left"></i> Back</a>
            <p class="ux-eyebrow">Maintenance</p>
            <h1 class="ux-title">Edit Request #@Model.RequestId</h1>
            <p class="ux-subtitle">Update request details, priority, assigned staff, and description.</p>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="ux-form-layout">
        <input type="hidden" asp-for="RequestId" />
        <div asp-validation-summary="ModelOnly" class="ux-form-error"></div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;"><i class="bi bi-wrench-adjustable"></i></div>
                <div><h3 class="ux-form-section-title">Request Details</h3><p class="ux-form-section-sub">Update type, priority, and assigned staff.</p></div>
            </div>
            <div class="ux-form-grid">
                <div class="ux-field">
                    <label class="ux-label">Unit</label>
                    <div style="position:relative;">
                        <input type="text" id="UnitId_display" class="ux-input" placeholder="Select unit..." autocomplete="off" readonly style="cursor:pointer;" />
                        <div id="UnitId_dropdown" style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1.5px solid #e2e8f0;border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,0.10);z-index:200;max-height:220px;overflow-y:auto;">
                            <div style="padding:0.5rem 0.75rem;">
                                <input type="text" id="UnitId_filter" class="ux-input" placeholder="Type to search..." autocomplete="off" style="font-size:0.85rem;padding:0.45rem 0.75rem;" />
                            </div>
                            <div id="UnitId_options"></div>
                        </div>
                    </div>
                    <select asp-for="UnitId" asp-items="ViewBag.UnitId" style="display:none;"></select>
                    <span asp-validation-for="UnitId" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="SkillId" class="ux-label">Maintenance Type</label>
                    <select asp-for="SkillId" class="ux-input" asp-items="ViewBag.SkillId"></select>
                    <span asp-validation-for="SkillId" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="Priority" class="ux-label">Priority</label>
                    <select asp-for="Priority" class="ux-input">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                    <span asp-validation-for="Priority" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label class="ux-label">Assigned Staff</label>
                    <div style="position:relative;">
                        <input type="text" id="AssignedStaffId_display" class="ux-input" placeholder="Select staff..." autocomplete="off" readonly style="cursor:pointer;" />
                        <div id="AssignedStaffId_dropdown" style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:#fff;border:1.5px solid #e2e8f0;border-radius:10px;box-shadow:0 6px 20px rgba(0,0,0,0.10);z-index:200;max-height:220px;overflow-y:auto;">
                            <div style="padding:0.5rem 0.75rem;">
                                <input type="text" id="AssignedStaffId_filter" class="ux-input" placeholder="Type to search..." autocomplete="off" style="font-size:0.85rem;padding:0.45rem 0.75rem;" />
                            </div>
                            <div id="AssignedStaffId_options"></div>
                        </div>
                    </div>
                    <select asp-for="AssignedStaffId" asp-items="ViewBag.AssignedStaffId" style="display:none;"></select>
                    <span asp-validation-for="AssignedStaffId" class="ux-field-error"></span>
                </div>
                <div class="ux-field" style="grid-column:1/-1;">
                    <label asp-for="Notes" class="ux-label">Description</label>
                    <textarea asp-for="Notes" class="ux-input" placeholder="Describe the issue..." style="min-height:100px;resize:vertical;"></textarea>
                    <span asp-validation-for="Notes" class="ux-field-error"></span>
                </div>
            </div>
        </div>

        <div class="ux-form-actions">
            <button type="submit" class="ux-btn-primary" style="padding:0.65rem 2rem;">
                <i class="bi bi-check-lg"></i> Save Changes
            </button>
            <a asp-action="Index" class="ux-btn-ghost" style="padding:0.65rem 1.5rem;">Cancel</a>
        </div>
    </form>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            makeSearchable('UnitId');
            makeSearchable('AssignedStaffId');
        });

        function makeSearchable(selectId) {
            var hiddenSelect = document.getElementById(selectId);
            if (!hiddenSelect) return;
            var allOptions = Array.from(hiddenSelect.options).filter(function (o) { return o.value !== ''; });
            var displayInput = document.getElementById(selectId + '_display');
            var dropdownDiv  = document.getElementById(selectId + '_dropdown');
            var filterInput  = document.getElementById(selectId + '_filter');
            var optionsList  = document.getElementById(selectId + '_options');

            function renderOptions(query) {
                optionsList.innerHTML = '';
                var q = query.trim().toLowerCase();
                var filtered = q ? allOptions.filter(function (o) { return o.text.toLowerCase().includes(q); }) : allOptions;
                if (filtered.length === 0) {
                    optionsList.innerHTML = '<div style="padding:0.6rem 1rem;color:#94a3b8;font-size:0.85rem;">No results found</div>';
                    return;
                }
                filtered.forEach(function (o) {
                    var item = document.createElement('div');
                    item.textContent = o.text;
                    item.style.cssText = 'padding:0.6rem 1rem;font-size:0.875rem;cursor:pointer;border-radius:6px;margin:0 4px;';
                    item.addEventListener('mouseenter', function () { this.style.background = '#f1f5f9'; });
                    item.addEventListener('mouseleave', function () { this.style.background = ''; });
                    item.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        hiddenSelect.value = o.value;
                        displayInput.value = o.text;
                        dropdownDiv.style.display = 'none';
                    });
                    optionsList.appendChild(item);
                });
            }

            displayInput.addEventListener('click', function () {
                renderOptions(filterInput.value);
                dropdownDiv.style.display = 'block';
                setTimeout(function () { filterInput.focus(); }, 50);
            });
            filterInput.addEventListener('input', function () { renderOptions(this.value); });
            document.addEventListener('mousedown', function (e) {
                if (!dropdownDiv.contains(e.target) && e.target !== displayInput) {
                    dropdownDiv.style.display = 'none';
                }
            });
            if (hiddenSelect.value) {
                var match = allOptions.find(function (o) { return o.value === hiddenSelect.value; });
                if (match) displayInput.value = match.text;
            }
        }
    </script>
}
