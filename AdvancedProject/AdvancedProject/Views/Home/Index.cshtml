@model AdvancedProject.ViewModels.MaintenanceLookupVM

@{
    ViewData["Title"] = "Maintenance Request Lookup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* ── Inline page-scoped styles ─────────────────────────────────── *@
<style>
    /* Hero section — break out of sidebar-main-content padding */
    .pub-hero {
        background: linear-gradient(135deg, #003d4d 0%, #005B71 45%, #0a7f8f 100%);
        padding: 4rem 1.5rem 6rem;
        text-align: center;
        position: relative;
        overflow: hidden;
        margin: -1.75rem -2rem 0;
    }
    @@media (max-width: 768px) {
        .pub-hero { margin: -1.25rem -1.25rem 0; }
    }
    .pub-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .pub-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 40px;
        padding: 0.35rem 1rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: rgba(255,255,255,0.85);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
    }
    .pub-hero-title {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 800;
        color: #ffffff;
        line-height: 1.2;
        letter-spacing: -0.03em;
        margin: 0 0 0.75rem;
    }
    .pub-hero-title span {
        color: #5ee8c8;
    }
    .pub-hero-subtitle {
        font-size: 1rem;
        color: rgba(255,255,255,0.7);
        max-width: 500px;
        margin: 0 auto 0;
        line-height: 1.6;
    }
    /* Decorative circles */
    .pub-hero-deco {
        position: absolute;
        border-radius: 50%;
        opacity: 0.07;
        background: #ffffff;
    }
    .pub-hero-deco-1 { width: 320px; height: 320px; top: -100px; right: -80px; }
    .pub-hero-deco-2 { width: 200px; height: 200px; bottom: -60px; left: -50px; }

    /* Floating card lifted above hero bottom */
    .pub-card-wrap {
        max-width: 660px;
        margin: -3rem auto 0;
        padding: 0 1rem;
        position: relative;
        z-index: 10;
    }
    .pub-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.13), 0 4px 16px rgba(0,0,0,0.06);
        padding: 2.5rem 2.25rem 2rem;
    }
    .pub-card-header {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.75rem;
    }
    .pub-card-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: rgba(0,91,113,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #005B71;
        font-size: 1.3rem;
        flex-shrink: 0;
    }
    .pub-card-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-main);
        margin: 0 0 0.15rem;
    }
    .pub-card-desc {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin: 0;
    }
    .pub-input-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }
    @@media (max-width: 520px) {
        .pub-input-row { grid-template-columns: 1fr; }
        .pub-card { padding: 1.75rem 1.25rem 1.5rem; }
    }
    .pub-field label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 0.4rem;
        letter-spacing: 0.01em;
    }
    .pub-field input {
        width: 100%;
        padding: 0.65rem 0.9rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        font-size: 0.9rem;
        color: var(--text-main);
        outline: none;
        transition: border-color 0.15s;
        background: #fafafa;
    }
    .pub-field input:focus { border-color: #005B71; background: #fff; }
    .pub-field .field-error {
        font-size: 0.75rem;
        color: #dc3545;
        margin-top: 0.3rem;
    }
    .pub-submit-btn {
        width: 100%;
        padding: 0.75rem;
        background: linear-gradient(135deg, #005B71, #0a7f8f);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-size: 0.92rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: opacity 0.15s, transform 0.15s;
        letter-spacing: 0.01em;
    }
    .pub-submit-btn:hover { opacity: 0.9; transform: translateY(-1px); }

    /* Result card */
    .pub-result-wrap {
        max-width: 660px;
        margin: 1.5rem auto 0;
        padding: 0 1rem;
    }
    .pub-result-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
        overflow: hidden;
        animation: fadeUp 0.3s ease;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .pub-result-header {
        background: linear-gradient(135deg, #003d4d, #005B71);
        padding: 1.4rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .pub-result-ticket {
        font-size: 0.75rem;
        font-weight: 700;
        color: rgba(255,255,255,0.6);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 0 0 0.2rem;
    }
    .pub-result-id {
        font-size: 1.5rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
    }
    .pub-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 1.1rem;
        border-radius: 40px;
        font-size: 0.82rem;
        font-weight: 700;
        border: 2px solid rgba(255,255,255,0.3);
    }
    .pub-result-body {
        padding: 1.75rem 2rem;
    }

    /* Timeline */
    .pub-timeline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        position: relative;
    }
    .pub-timeline::before {
        content: "";
        position: absolute;
        top: 18px;
        left: 18px;
        right: 18px;
        height: 3px;
        background: #e5e7eb;
        z-index: 0;
    }
    .pub-tl-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        position: relative;
        z-index: 1;
        flex: 1;
    }
    .pub-tl-dot {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        border: 3px solid #e5e7eb;
        background: #f9fafb;
        color: #9ca3af;
        transition: all 0.2s;
    }
    .pub-tl-dot.active {
        background: #005B71;
        border-color: #005B71;
        color: #ffffff;
        box-shadow: 0 0 0 4px rgba(0,91,113,0.15);
    }
    .pub-tl-dot.done {
        background: #1E8E6E;
        border-color: #1E8E6E;
        color: #ffffff;
    }
    .pub-tl-dot.cancelled {
        background: #dc3545;
        border-color: #dc3545;
        color: #ffffff;
    }
    .pub-tl-label {
        font-size: 0.68rem;
        font-weight: 600;
        color: #9ca3af;
        text-align: center;
        white-space: nowrap;
    }
    .pub-tl-label.active { color: #005B71; }
    .pub-tl-label.done   { color: #1E8E6E; }
    .pub-tl-label.cancelled { color: #dc3545; }

    /* Detail grid */
    .pub-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    @@media (max-width: 520px) { .pub-detail-grid { grid-template-columns: 1fr; } }
    .pub-detail-item {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1rem 1.1rem;
        border: 1px solid #f0f0f0;
    }
    .pub-detail-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.3rem;
    }
    .pub-detail-value {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--text-main);
    }
    .pub-notes-block {
        margin-top: 1rem;
        background: #f8fafc;
        border-radius: 12px;
        padding: 1rem 1.1rem;
        border: 1px solid #f0f0f0;
        border-left: 4px solid #005B71;
    }
    .pub-notes-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.4rem;
    }
    .pub-notes-text {
        font-size: 0.875rem;
        color: var(--text-main);
        line-height: 1.6;
    }

    /* Not found */
    .pub-notfound {
        max-width: 660px;
        margin: 1.5rem auto 0;
        padding: 0 1rem;
    }
    .pub-notfound-card {
        background: #fff5f5;
        border: 1px solid #fee2e2;
        border-left: 4px solid #dc3545;
        border-radius: 16px;
        padding: 1.5rem 1.75rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        animation: fadeUp 0.3s ease;
    }
    .pub-notfound-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(220,53,69,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #dc3545;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    .pub-notfound-title { font-size: 0.95rem; font-weight: 700; color: #991b1b; margin: 0 0 0.25rem; }
    .pub-notfound-text  { font-size: 0.85rem; color: #7f1d1d; margin: 0; line-height: 1.5; }

    /* Info strip at the bottom */
    .pub-info-strip {
        max-width: 660px;
        margin: 2rem auto 3rem;
        padding: 0 1rem;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
    @@media (max-width: 560px) { .pub-info-strip { grid-template-columns: 1fr; } }
    .pub-info-item {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 1px 6px rgba(0,0,0,0.04);
        padding: 1.1rem 1rem;
        text-align: center;
    }
    .pub-info-icon {
        font-size: 1.5rem;
        color: #005B71;
        margin-bottom: 0.5rem;
    }
    .pub-info-title { font-size: 0.82rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.2rem; }
    .pub-info-text  { font-size: 0.75rem; color: var(--text-muted); line-height: 1.4; margin: 0; }

    /* Login nudge */
    .pub-login-nudge {
        max-width: 660px;
        margin: 0 auto 0;
        padding: 0 1rem;
        text-align: center;
    }
    .pub-login-nudge p {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin: 0;
    }
    .pub-login-nudge a {
        color: #005B71;
        font-weight: 600;
        text-decoration: none;
    }
    .pub-login-nudge a:hover { text-decoration: underline; }
</style>

@* ── Hero ────────────────────────────────────────────────────────── *@
<div class="pub-hero">
    <div class="pub-hero-deco pub-hero-deco-1"></div>
    <div class="pub-hero-deco pub-hero-deco-2"></div>

    <div style="position:relative;z-index:1;">
        <div class="pub-hero-badge">
            <i class="bi bi-building-fill"></i>
            Property Leasing &amp; Maintenance Platform
        </div>
        <h1 class="pub-hero-title">Track Your <span>Maintenance</span> Request</h1>
        <p class="pub-hero-subtitle">
            Enter your ticket number and registered phone number to view the real-time
            status of your maintenance request — no login required.
        </p>
    </div>
</div>

@* ── Lookup form card ─────────────────────────────────────────── *@
<div class="pub-card-wrap">
    <div class="pub-card">
        <div class="pub-card-header">
            <div class="pub-card-icon"><i class="bi bi-search-heart-fill"></i></div>
            <div>
                <p class="pub-card-title">Request Lookup</p>
                <p class="pub-card-desc">Your ticket number was provided when you submitted the request.</p>
            </div>
        </div>

        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div class="pub-input-row">
                <div class="pub-field">
                    <label asp-for="TicketNumber">
                        <i class="bi bi-hash" style="opacity:.6;"></i> Ticket Number
                    </label>
                    <input asp-for="TicketNumber" type="number" min="1"
                           placeholder="e.g. 1042" autocomplete="off" />
                    <span asp-validation-for="TicketNumber" class="field-error"></span>
                </div>
                <div class="pub-field">
                    <label asp-for="Phone">
                        <i class="bi bi-telephone" style="opacity:.6;"></i> Registered Phone
                    </label>
                    <input asp-for="Phone" type="tel"
                           placeholder="e.g. 33001122" autocomplete="off" />
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(""))
            {
                <div style="background:#fff5f5;border:1px solid #fee2e2;border-radius:8px;padding:0.65rem 0.9rem;font-size:0.83rem;color:#991b1b;margin-bottom:1rem;">
                    <i class="bi bi-exclamation-circle-fill me-1"></i>
                    @ViewData.ModelState[""]?.Errors.FirstOrDefault()?.ErrorMessage
                </div>
            }

            <button type="submit" class="pub-submit-btn">
                <i class="bi bi-search"></i> Look Up Request
            </button>
        </form>
    </div>
</div>

@* ── Login nudge ──────────────────────────────────────────────── *@
<div class="pub-login-nudge mt-3">
    <p>Already have an account? <a asp-controller="Account" asp-action="Login">Sign in for full access</a></p>
</div>

@* ── Not found state ──────────────────────────────────────────── *@
@if (Model?.NotFound == true)
{
    <div class="pub-notfound">
        <div class="pub-notfound-card">
            <div class="pub-notfound-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <p class="pub-notfound-title">No Request Found</p>
                <p class="pub-notfound-text">
                    We couldn't find a maintenance request matching ticket
                    <strong>#@Model.TicketNumber</strong> with the provided phone number.
                    Please double-check your details or contact the property office for assistance.
                </p>
            </div>
        </div>
    </div>
}

@* ── Result card ──────────────────────────────────────────────── *@
@if (Model?.Result != null)
{
    var r = Model.Result;

    // Determine status colors
    string statusColor = r.Status switch
    {
        "Pending"     => "#b45309",
        "Assigned"    => "#2563eb",
        "In Progress" => "#7c3aed",
        "Resolved"    => "#1E8E6E",
        "Closed"      => "#4b5563",
        "Cancelled"   => "#dc3545",
        _             => "#6b7280"
    };
    string statusBg = r.Status switch
    {
        "Pending"     => "rgba(245,158,11,0.2)",
        "Assigned"    => "rgba(59,130,246,0.2)",
        "In Progress" => "rgba(124,58,237,0.2)",
        "Resolved"    => "rgba(30,142,110,0.2)",
        "Closed"      => "rgba(75,85,99,0.2)",
        "Cancelled"   => "rgba(220,53,69,0.2)",
        _             => "rgba(107,114,128,0.2)"
    };
    string priorityColor = r.Priority switch
    {
        "High"   => "#dc3545",
        "Medium" => "#f59e0b",
        "Low"    => "#1E8E6E",
        _        => "#6b7280"
    };

    // Timeline step states
    var steps = new[] { "Pending", "Assigned", "In Progress", "Resolved", "Closed" };
    bool isCancelled = r.Status == "Cancelled";
    int activeIdx = Array.IndexOf(steps, r.Status);

    <div class="pub-result-wrap">
        <div class="pub-result-card">
            <div class="pub-result-header">
                <div>
                    <p class="pub-result-ticket">Ticket Number</p>
                    <p class="pub-result-id">#@r.RequestId</p>
                </div>
                <span class="pub-status-badge" style="background:@statusBg;color:@statusColor;">
                    @if (r.Status == "Closed") { <i class="bi bi-check2-all"></i> }
                    else if (r.Status == "Resolved") { <i class="bi bi-check-circle-fill"></i> }
                    else if (r.Status == "Cancelled") { <i class="bi bi-x-circle-fill"></i> }
                    else if (r.Status == "In Progress") { <i class="bi bi-tools"></i> }
                    else if (r.Status == "Assigned") { <i class="bi bi-person-check-fill"></i> }
                    else { <i class="bi bi-hourglass-split"></i> }
                    @r.Status
                </span>
            </div>

            <div class="pub-result-body">

                @* Timeline *@
                @if (!isCancelled)
                {
                    <div class="pub-timeline">
                        @foreach (var (step, i) in steps.Select((s, i) => (s, i)))
                        {
                            string dotClass = i < activeIdx ? "done" : (i == activeIdx ? "active" : "");
                            <div class="pub-tl-step">
                                <div class="pub-tl-dot @dotClass">
                                    @if (i < activeIdx || i == activeIdx && (r.Status == "Closed" || r.Status == "Resolved"))
                                    { <i class="bi bi-check-lg"></i> }
                                    else if (i == activeIdx)
                                    { <i class="bi bi-circle-fill" style="font-size:0.5rem;"></i> }
                                    else
                                    { <span style="font-size:0.7rem;font-weight:700;">@(i+1)</span> }
                                </div>
                                <span class="pub-tl-label @dotClass">@step</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align:center;padding:0.75rem 0 1.25rem;">
                        <span style="background:rgba(220,53,69,0.1);color:#dc3545;padding:0.4rem 1.2rem;border-radius:40px;font-size:0.82rem;font-weight:700;">
                            <i class="bi bi-x-circle-fill me-1"></i> This request has been cancelled
                        </span>
                    </div>
                }

                @* Detail grid *@
                <div class="pub-detail-grid">
                    <div class="pub-detail-item">
                        <div class="pub-detail-label"><i class="bi bi-calendar3 me-1"></i>Submitted On</div>
                        <div class="pub-detail-value">@r.RequestDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="pub-detail-item">
                        <div class="pub-detail-label"><i class="bi bi-door-open me-1"></i>Unit</div>
                        <div class="pub-detail-value">@r.UnitNumber</div>
                    </div>
                    <div class="pub-detail-item">
                        <div class="pub-detail-label"><i class="bi bi-tools me-1"></i>Maintenance Type</div>
                        <div class="pub-detail-value">@r.SkillName</div>
                    </div>
                    <div class="pub-detail-item">
                        <div class="pub-detail-label"><i class="bi bi-exclamation-diamond me-1"></i>Priority</div>
                        <div class="pub-detail-value" style="color:@priorityColor;">@r.Priority</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(r.AssignedStaffName))
                    {
                        <div class="pub-detail-item" style="grid-column:1/-1;">
                            <div class="pub-detail-label"><i class="bi bi-person-badge me-1"></i>Assigned Staff</div>
                            <div class="pub-detail-value">@r.AssignedStaffName</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(r.Notes))
                {
                    <div class="pub-notes-block">
                        <div class="pub-notes-label"><i class="bi bi-chat-left-text me-1"></i>Request Notes</div>
                        <p class="pub-notes-text">@r.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ── Info strip ───────────────────────────────────────────────── *@
<div class="pub-info-strip">
    <div class="pub-info-item">
        <div class="pub-info-icon"><i class="bi bi-shield-check"></i></div>
        <p class="pub-info-title">Secure &amp; Private</p>
        <p class="pub-info-text">Only you can view your request using your unique ticket and phone number.</p>
    </div>
    <div class="pub-info-item">
        <div class="pub-info-icon"><i class="bi bi-clock-history"></i></div>
        <p class="pub-info-title">Real-Time Status</p>
        <p class="pub-info-text">Status updates are reflected immediately as our team works on your request.</p>
    </div>
    <div class="pub-info-item">
        <div class="pub-info-icon"><i class="bi bi-headset"></i></div>
        <p class="pub-info-title">Need Help?</p>
        <p class="pub-info-text">Contact the property office if you can't locate your ticket number.</p>
    </div>
</div>
