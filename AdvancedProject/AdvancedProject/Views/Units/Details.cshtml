@model AdvancedProjectAPI.Models.Unit

@{
    ViewData["Title"] = "Unit Details";
}

<div class="unit-details-page">

    <div class="unit-details-hero shadow-soft">

        <div>
            <p class="unit-details-eyebrow">
                Unit Details
            </p>

            <h1 class="unit-details-title">
                Unit @Model.UnitNumber
            </h1>

            <p class="unit-details-subtitle">
                @Model.Property?.Name
            </p>

            @if (Model.AvailabilityStatus == "Available")
            {
                <span class="custom-pill unit-status-available mt-2">
                    Available
                </span>
            }
            else if (Model.AvailabilityStatus == "Occupied")
            {
                <span class="custom-pill unit-status-occupied mt-2">
                    Occupied
                </span>
            }
            else
            {
                <span class="custom-pill unit-status-default mt-2">
                    @Model.AvailabilityStatus
                </span>
            }

        </div>

        <div class="unit-details-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.UnitId"
               class="btn unit-details-edit-btn">
                Edit Unit
            </a>

            @if (User.IsInRole("PropertyManager"))
            {
                <button type="button" class="btn btn-danger"
                        data-bs-toggle="modal" data-bs-target="#deleteUnitModal">
                    Delete Unit
                </button>
            }

            <a asp-action="Index"
               asp-route-id="@ViewBag.PropertyId"
               class="btn unit-details-back-btn">
                Back to Units
            </a>

        </div>

    </div>

    <div class="unit-details-grid mt-4">

        <div class="unit-info-card">
            <span class="info-label">Property</span>
            <span class="info-value">
                @Model.Property?.Name
            </span>
        </div>

        <div class="unit-info-card">
            <span class="info-label">Unit Type</span>
            <span class="info-value">
                @Model.UnitType?.Name
            </span>
        </div>

        <div class="unit-info-card">
            <span class="info-label">Monthly Rent</span>
            <span class="info-value">
                BD @Model.RentAmount.ToString("0")
            </span>
        </div>

        <div class="unit-info-card">
            <span class="info-label">Size</span>
            <span class="info-value">
                @Model.SizeSqFt.ToString("0") SqFt
            </span>
        </div>

    </div>

    <div class="details-section-card mt-4">

        <div class="section-header">
            <h3>Amenities</h3>
            <p>
                Features included with this unit.
            </p>
        </div>

        @if (Model.Amenities != null && Model.Amenities.Any())
        {
            <div class="unit-amenities-display-grid">

                @foreach (var amenity in Model.Amenities)
                {
                    <div class="unit-amenity-display-card">
                        @amenity.Name
                    </div>
                }

            </div>
        }
        else
        {
            <div class="unit-empty-box">
                No amenities available for this unit.
            </div>
        }

    </div>

</div>

@if (User.IsInRole("PropertyManager"))
{
    <div class="modal fade" id="deleteUnitModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Delete Unit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to delete <strong>Unit @Model.UnitNumber</strong>? This action will deactivate the unit and it will no longer appear in the system.
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="SoftDelete" asp-controller="Units" asp-route-id="@Model.UnitId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger lease-action-btn">Confirm Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}