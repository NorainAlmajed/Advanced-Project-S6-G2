@model AdvancedProject.Models.Unit

@{
    ViewData["Title"] = "Unit Details";
}

<div class="unit-details-page">

    <div class="unit-details-hero shadow-soft">

        <div>
            <p class="unit-details-eyebrow">
                Unit Details
            </p>

            <h1 class="unit-details-title">
                Unit @Model.UnitNumber
            </h1>

            <p class="unit-details-subtitle">
                @Model.Property?.Name
            </p>

            @if (Model.AvailabilityStatus == "Available")
            {
                <span class="custom-pill unit-status-available mt-2">
                    Available
                </span>
            }
            else if (Model.AvailabilityStatus == "Occupied")
            {
                <span class="custom-pill unit-status-occupied mt-2">
                    Occupied
                </span>
            }
            else
            {
                <span class="custom-pill unit-status-default mt-2">
                    @Model.AvailabilityStatus
                </span>
            }

        </div>

        <div class="unit-details-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.UnitId"
               class="btn unit-details-edit-btn">

                Edit Unit

            </a>

            <a asp-action="Index"
               asp-route-id="@ViewBag.PropertyId"
               class="btn unit-details-back-btn">

                Back to Units

            </a>

        </div>

    </div>

    <div class="unit-details-grid mt-4">

        <div class="unit-info-card">
            <span class="info-label">Property</span>
            <span class="info-value">
                @Model.Property?.Name
            </span>
        </div>

        <div class="unit-info-card">
            <span class="info-label">Unit Type</span>
            <span class="info-value">
                @Model.UnitType?.Name
            </span>
        </div>

        <div class="unit-info-card">
            <span class="info-label">Monthly Rent</span>
            <span class="info-value">
                BD @Model.RentAmount.ToString("0")
            </span>
        </div>

        <div class="unit-info-card">
            <span class="info-label">Size</span>
            <span class="info-value">
                @Model.SizeSqFt.ToString("0") SqFt
            </span>
        </div>

    </div>

    <div class="details-section-card mt-4">

        <div class="section-header">
            <h3>Amenities</h3>
            <p>
                Features included with this unit.
            </p>
        </div>

        @if (Model.Amenities != null && Model.Amenities.Any())
        {
            <div class="unit-amenities-display-grid">

                @foreach (var amenity in Model.Amenities)
                {
                    <div class="unit-amenity-display-card">
                        @amenity.Name
                    </div>
                }

            </div>
        }
        else
        {
            <div class="unit-empty-box">
                No amenities available for this unit.
            </div>
        }

    </div>

</div>