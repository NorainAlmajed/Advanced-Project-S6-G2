@model IEnumerable<AdvancedProjectAPI.Models.Unit>

@{
    ViewData["Title"] = "Units";
    var currentStatus    = ViewBag.CurrentStatus as string ?? "All";
    var propertyId       = ViewBag.PropertyId;
    var selectedAmenities = ViewBag.SelectedAmenities as int[] ?? Array.Empty<int>();
    var amenityList      = ViewBag.AmenityList as List<AdvancedProjectAPI.Models.Amenity> ?? new List<AdvancedProjectAPI.Models.Amenity>();
    int total     = Model?.Count() ?? 0;
    int available = Model?.Count(u => u.AvailabilityStatus == "Available") ?? 0;
    int occupied  = Model?.Count(u => u.AvailabilityStatus == "Occupied")  ?? 0;
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Property Management</p>
            <h1 class="ux-title">@(ViewBag.PropertyName != null ? ViewBag.PropertyName + " — Units" : "Units")</h1>
            <p class="ux-subtitle">Browse available and occupied units.</p>
        </div>
        @if (User.IsInRole("PropertyManager"))
        {
            <a asp-action="Create" asp-route-propertyId="@ViewBag.PropertyId" class="ux-btn-primary">
                <i class="bi bi-plus-lg"></i> Add Unit
            </a>
        }
    </div>

    <div class="ux-stats-row">
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                <i class="bi bi-building"></i>
            </div>
            <div>
                <div class="ux-stat-value">@total</div>
                <div class="ux-stat-label">Total Units</div>
            </div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <div class="ux-stat-value">@available</div>
                <div class="ux-stat-label">Available</div>
            </div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(220,53,69,0.1);color:#dc3545;">
                <i class="bi bi-person-fill-lock"></i>
            </div>
            <div>
                <div class="ux-stat-value">@occupied</div>
                <div class="ux-stat-label">Occupied</div>
            </div>
        </div>
    </div>

    <div class="ux-toolbar" style="align-items:flex-start;flex-wrap:wrap;gap:0.75rem;">
        <form asp-action="Index" method="get" class="ux-search-form" style="flex-wrap:wrap;gap:0.5rem;flex:1;">
            <input type="hidden" name="id" value="@propertyId" />

            <div class="ux-search-wrap">
                <i class="bi bi-search ux-search-icon"></i>
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                       class="ux-search-input" placeholder="Search by unit number or type..." />
            </div>

            <select name="typeFilter" asp-items="ViewBag.TypeList"
                    class="ux-select-sm">
                <option value="">All Types</option>
            </select>

            <select name="priceFilter" class="ux-select-sm">
                <option value="">All Prices</option>
                <option value="Under300"  selected="@(ViewBag.CurrentPrice == "Under300")">Under BD 300</option>
                <option value="300to400"  selected="@(ViewBag.CurrentPrice == "300to400")">BD 300 – 400</option>
                <option value="401to500"  selected="@(ViewBag.CurrentPrice == "401to500")">BD 401 – 500</option>
                <option value="Above500"  selected="@(ViewBag.CurrentPrice == "Above500")">Above BD 500</option>
            </select>

            <select name="statusFilter" class="ux-select-sm">
                <option value="All"       selected="@(currentStatus == "All")">All Statuses</option>
                <option value="Available" selected="@(currentStatus == "Available")">Available</option>
                <option value="Occupied"  selected="@(currentStatus == "Occupied")">Occupied</option>
            </select>

            <div class="dropdown">
                <button class="ux-btn-ghost dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" data-bs-auto-close="outside"
                        aria-expanded="false" style="white-space:nowrap;">
                    <i class="bi bi-funnel"></i>
                    Amenities@(selectedAmenities.Length > 0 ? $" ({selectedAmenities.Length})" : "")
                </button>
                <div class="dropdown-menu p-3" style="min-width:220px;">
                    @if (amenityList.Any())
                    {
                        @foreach (var amenity in amenityList)
                        {
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox"
                                       name="selectedAmenities"
                                       value="@amenity.AmenityId"
                                       id="am_@amenity.AmenityId"
                                       @(selectedAmenities.Contains(amenity.AmenityId) ? "checked" : "") />
                                <label class="form-check-label" style="font-size:0.875rem;" for="am_@amenity.AmenityId">
                                    @amenity.Name
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <span style="font-size:0.875rem;color:var(--text-muted);">No amenities available</span>
                    }
                </div>
            </div>

            <button type="submit" class="ux-btn-primary">Search</button>
            <a asp-action="Index" asp-route-id="@propertyId" class="ux-btn-ghost">Reset</a>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="unit-index-grid">
            @foreach (var item in Model)
            {
                string statusColor = item.AvailabilityStatus switch
                {
                    "Available" => "#1E8E6E",
                    "Occupied"  => "#dc3545",
                    _           => "#6b7280"
                };
                string statusBg = item.AvailabilityStatus switch
                {
                    "Available" => "rgba(30,142,110,0.1)",
                    "Occupied"  => "rgba(220,53,69,0.1)",
                    _           => "rgba(107,114,128,0.1)"
                };
                string borderColor = item.AvailabilityStatus switch
                {
                    "Available" => "#1E8E6E",
                    "Occupied"  => "#dc3545",
                    _           => "#e5e7eb"
                };

                <div class="unit-card-new" style="border-left-color:@borderColor;">

                    <div class="unit-card-top">
                        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                            <span class="unit-number">Unit @item.UnitNumber</span>
                            @if (item.UnitType != null)
                            {
                                <span class="unit-type-pill">@item.UnitType.Name</span>
                            }
                        </div>
                        <span class="ux-role-badge" style="background:@statusBg;color:@statusColor;flex-shrink:0;">
                            @item.AvailabilityStatus
                        </span>
                    </div>

                    <div class="unit-meta">
                        <div class="unit-meta-row">
                            <i class="bi bi-rulers" style="color:var(--text-muted);font-size:0.8rem;"></i>
                            <span>@item.SizeSqFt sqft</span>
                        </div>
                        <div class="unit-meta-row">
                            <i class="bi bi-cash-coin" style="color:var(--text-muted);font-size:0.8rem;"></i>
                            <span>BD @item.RentAmount / mo</span>
                        </div>
                    </div>

                    <div class="unit-amenities">
                        @if (item.Amenities != null && item.Amenities.Any())
                        {
                            @foreach (var amenity in item.Amenities.Take(4))
                            {
                                <span class="unit-amenity-chip">@amenity.Name</span>
                            }
                            @if (item.Amenities.Count > 4)
                            {
                                <span class="unit-amenity-chip unit-amenity-more">+@(item.Amenities.Count - 4)</span>
                            }
                        }
                        else
                        {
                            <span style="font-size:0.78rem;color:var(--text-muted);">No amenities listed</span>
                        }
                    </div>

                    <div class="unit-card-footer">
                        <a asp-action="Details"
                           asp-route-id="@item.UnitId"
                           asp-route-propertyId="@item.PropertyId"
                           class="ux-details-btn">
                            View Details <i class="bi bi-arrow-right"></i>
                        </a>

                        @if (item.AvailabilityStatus != "Occupied")
                        {
                            @if (User.IsInRole("Tenant"))
                            {
                                <a asp-controller="LeaseApplications"
                                   asp-action="Create"
                                   asp-route-unitId="@item.UnitId"
                                   class="ux-btn-outline unit-action-btn">
                                    <i class="bi bi-file-earmark-text"></i> Apply
                                </a>
                            }
                            else if (User.IsInRole("PropertyManager"))
                            {
                                <a asp-controller="Leases"
                                   asp-action="Create"
                                   asp-route-unitId="@item.UnitId"
                                   class="ux-btn-outline unit-action-btn">
                                    <i class="bi bi-file-earmark-plus"></i> Create Lease
                                </a>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="ux-table-card">
            <div class="ux-empty">
                <i class="bi bi-building"></i>
                <p>No units found matching the selected filters.</p>
            </div>
        </div>
    }

</div>
