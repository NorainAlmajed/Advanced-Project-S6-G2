@model AdvancedProject.Models.Unit

@{
    ViewData["Title"] = "Create Unit";
}

<div class="unit-form-page">
    <div class="lease-form-wrapper">
        <div class="lease-form-card shadow-soft">

            <div class="lease-form-header">
                <p class="lease-form-eyebrow mb-2">Unit</p>

                <h1 class="lease-form-title mb-2">
                    Create Unit
                </h1>

                <p class="lease-form-subtitle mb-0">
                    Add a new unit with rent details and amenities.
                </p>
            </div>

            <form asp-action="Create" method="post" class="lease-form-body">

                <input type="hidden" asp-for="PropertyId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="UnitNumber" class="lease-form-label">
                            Unit Number
                        </label>

                        <input asp-for="UnitNumber"
                               class="form-control lease-form-input"
                               placeholder="Enter unit number" />

                        <span asp-validation-for="UnitNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="UnitTypeId" class="lease-form-label">
                            Unit Type
                        </label>

                        <select asp-for="UnitTypeId"
                                class="form-select lease-form-input"
                                asp-items="ViewBag.UnitTypeId">

                            <option value="">Select unit type</option>

                        </select>

                        <span asp-validation-for="UnitTypeId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="SizeSqFt" class="lease-form-label">
                            Size Sq Ft
                        </label>

                        <input asp-for="SizeSqFt"
                               type="text"
                               class="form-control lease-form-input"
                               placeholder="Enter size"
                               value="@(Model.SizeSqFt == 0 ? "" : Model.SizeSqFt.ToString())" />

                        <span asp-validation-for="SizeSqFt" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="RentAmount" class="lease-form-label">
                            Rent Amount
                        </label>

                        <input asp-for="RentAmount"
                               type="text"
                               class="form-control lease-form-input"
                               placeholder="Enter rent amount"
                               value="@(Model.RentAmount == 0 ? "" : Model.RentAmount.ToString())" />

                        <span asp-validation-for="RentAmount" class="text-danger"></span>
                    </div>

                </div>

                <div class="lease-form-group mt-3">
                    <label class="lease-form-label">
                        Amenities
                    </label>

                    <div class="unit-amenities-grid">
                        @if (ViewBag.AmenityList != null)
                        {
                            foreach (var amenity in ViewBag.AmenityList)
                            {
                                <label class="unit-amenity-card">
                                    <input type="checkbox"
                                           name="selectedAmenities"
                                           value="@amenity.AmenityId"
                                           id="amenity_@amenity.AmenityId" />

                                    <span>@amenity.Name</span>
                                </label>
                            }
                        }
                    </div>
                </div>

                <div class="lease-form-actions">
                    <button type="submit" class="btn btn-primary lease-submit-btn">
                        Create Unit
                    </button>

                    <a asp-action="Index"
                       asp-route-id="@Model.PropertyId"
                       class="lease-back-link">
                        Back to List
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}