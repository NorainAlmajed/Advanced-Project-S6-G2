@model AdvancedProjectAPI.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="ux-page lease-details-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <p class="ux-eyebrow mb-2">PAYMENT DETAILS</p>
            <h1 class="ux-title mb-2">Payment #@Model.PaymentId</h1>
            <p class="ux-subtitle mb-0">
                View payment amount, status, lease, property, unit, method, and frequency.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("PropertyManager"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.PaymentId"
                   class="ux-btn-primary">
                    Edit Payment
                </a>
            }
            <a asp-action="Index" class="ux-btn-ghost">
                Back to List
            </a>
        </div>
    </div>

    <div class="lease-details-card">

        <div class="section-header">
            <h3>Payment Information</h3>
            <p>Main payment details and payment status.</p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">AMOUNT</div>
                    <div class="info-value">BD @Model.Amount.ToString("0.00")</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">STATUS</div>
                    <div class="info-value">@Model.Status</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">START DATE</div>
                    <div class="info-value">@Model.StartDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">END DATE</div>
                    <div class="info-value">@Model.EndDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">LEASE ID</div>
                    <div class="info-value">#@Model.Lease.LeaseId</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">PROPERTY</div>
                    <div class="info-value">@Model.Lease.Unit.Property.Name</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">UNIT NUMBER</div>
                    <div class="info-value">@Model.Lease.Unit.UnitNumber</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">PAYMENT METHOD</div>
                    <div class="info-value">@Model.PaymentMethod.Name</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-box">
                    <div class="info-label">PAYMENT FREQUENCY</div>
                    <div class="info-value">@Model.PaymentFrequency.Name</div>
                </div>
            </div>

        </div>

    </div>

</div>