@model IEnumerable<AdvancedProjectAPI.Models.Payment>

@{
    ViewData["Title"] = "Payments";
    var currentSearch = ViewData["CurrentSearchTerm"]?.ToString() ?? "";
    var currentStatus = ViewData["CurrentStatusFilter"]?.ToString() ?? "";
    var currentDate   = ViewData["CurrentDateFilter"]?.ToString() ?? "";
    int total   = Model.Count();
    int paid    = Model.Count(p => p.Status == "Paid");
    int pending = Model.Count(p => p.Status == "Pending");
    int late    = Model.Count(p => p.Status == "Late");
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Financial</p>
            <h1 class="ux-title">Payments</h1>
            <p class="ux-subtitle">Track and manage lease payment records.</p>
        </div>
        @if (User.IsInRole("PropertyManager"))
        {
            <a asp-action="Create" class="ux-btn-primary">
                <i class="bi bi-plus-lg"></i> Create Payment
            </a>
        }
    </div>

    <div class="ux-stats-row">
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(0,91,113,0.1);color:#005B71;"><i class="bi bi-credit-card-fill"></i></div>
            <div><div class="ux-stat-value">@total</div><div class="ux-stat-label">Total Payments</div></div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;"><i class="bi bi-check-circle-fill"></i></div>
            <div><div class="ux-stat-value">@paid</div><div class="ux-stat-label">Paid</div></div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(245,158,11,0.1);color:#d97706;"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="ux-stat-value">@pending</div><div class="ux-stat-label">Pending</div></div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(220,53,69,0.1);color:#b42318;"><i class="bi bi-exclamation-circle-fill"></i></div>
            <div><div class="ux-stat-value">@late</div><div class="ux-stat-label">Late</div></div>
        </div>
    </div>

    <div class="ux-toolbar">
        <form asp-action="Index" method="get" class="ux-search-form">
            <div class="ux-search-wrap">
                <i class="bi bi-search ux-search-icon"></i>
                <input type="text" name="searchTerm" value="@currentSearch"
                       class="ux-search-input" placeholder="Search by payment ID or lease ID..." />
            </div>
            <select name="statusFilter" class="ux-search-input" style="width:150px;padding:0.55rem 0.85rem;border:1.5px solid #e5e7eb;border-radius:8px;font-size:0.875rem;outline:none;">
                <option value="">All Statuses</option>
                <option value="Paid"    selected="@(currentStatus=="Paid")">Paid</option>
                <option value="Pending" selected="@(currentStatus=="Pending")">Pending</option>
                <option value="Late"    selected="@(currentStatus=="Late")">Late</option>
            </select>
            <select name="dateFilter" class="ux-search-input" style="width:130px;padding:0.55rem 0.85rem;border:1.5px solid #e5e7eb;border-radius:8px;font-size:0.875rem;outline:none;">
                <option value="">All Dates</option>
                <option value="Latest" selected="@(currentDate=="Latest")">Latest First</option>
                <option value="Oldest" selected="@(currentDate=="Oldest")">Oldest First</option>
            </select>
            <button type="submit" class="ux-btn-primary">Search</button>
            <a asp-action="Index" class="ux-btn-ghost">Reset</a>
        </form>
    </div>

    <div class="ux-table-card">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="ux-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Lease</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string statusColor = item.Status == "Paid" ? "#1E8E6E" : item.Status == "Late" ? "#b42318" : "#d97706";
                            string statusBg    = item.Status == "Paid" ? "rgba(30,142,110,0.1)" : item.Status == "Late" ? "rgba(220,53,69,0.1)" : "rgba(245,158,11,0.1)";
                            <tr>
                                <td class="ux-cell-muted fw-semibold">#@item.PaymentId</td>
                                <td class="ux-cell-muted">Lease #@item.LeaseId</td>
                                <td class="ux-cell-muted">@item.StartDate.ToString("dd MMM yyyy")</td>
                                <td class="ux-cell-muted">@item.EndDate.ToString("dd MMM yyyy")</td>
                                <td class="ux-user-name">BD @item.Amount.ToString("0.00")</td>
                                <td><span class="ux-role-badge" style="background:@statusBg;color:@statusColor;">@item.Status</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.PaymentId" class="ux-details-btn">
                                        View <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ux-empty">
                <i class="bi bi-credit-card"></i>
                <p>No payments found.</p>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (AdvancedProject.ViewModels.PaginationVM)ViewBag.Pagination)

</div>
