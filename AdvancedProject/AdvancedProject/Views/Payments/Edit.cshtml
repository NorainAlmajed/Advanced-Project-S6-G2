@model AdvancedProjectAPI.Models.Payment

@{
    ViewData["Title"] = "Edit Payment";
}

<div class="lease-form-page">
    <div class="lease-form-wrapper">
        <div class="lease-form-card shadow-soft">

            <div class="lease-form-header">
                <p class="lease-form-eyebrow mb-2">Payment</p>
                <h1 class="lease-form-title mb-2">Edit Payment</h1>
                <p class="lease-form-subtitle mb-0">
                    Update the payment date, status, method, and frequency.
                </p>
            </div>

            <form asp-action="Edit" method="post" class="lease-form-body">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="PaymentId" />

                <div class="lease-form-group">
                    <label asp-for="StartDate" class="lease-form-label">Start Date</label>
                    <input asp-for="StartDate" type="date" class="form-control lease-form-input" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="lease-form-group">
                    <label asp-for="Status" class="lease-form-label"></label>
                    <select asp-for="Status" class="form-control lease-form-input" asp-items="ViewBag.StatusList"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="lease-form-group">
                    <label asp-for="PaymentMethodId" class="lease-form-label">Payment Method</label>
                    <select asp-for="PaymentMethodId" class="form-control lease-form-input" asp-items="ViewBag.PaymentMethodId"></select>
                    <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
                </div>

                <div class="lease-form-group">
                    <label asp-for="PaymentFrequencyId" class="lease-form-label">Payment Frequency</label>
                    <select asp-for="PaymentFrequencyId" class="form-control lease-form-input" asp-items="ViewBag.PaymentFrequencyId"></select>
                    <span asp-validation-for="PaymentFrequencyId" class="text-danger"></span>
                </div>

                <div class="lease-form-actions">
                    <button type="submit" class="btn btn-primary lease-submit-btn">
                        Save Changes
                    </button>

                    <a asp-action="Index" class="lease-back-link">
                        Back to List
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}