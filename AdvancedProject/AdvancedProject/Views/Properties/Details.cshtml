@model AdvancedProjectAPI.Models.Property

@{
    ViewData["Title"] = "Property Details";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Property Management</p>
            <h1 class="ux-title">@Model.Name</h1>
            <p class="ux-subtitle">
                @if (!string.IsNullOrEmpty(Model.Governorate?.Name))
                {
                    <i class="bi bi-geo-alt-fill" style="color:var(--accent);"></i>
                    @Model.Governorate.Name
                    @if (!string.IsNullOrEmpty(Model.City))
                    {
                        <span> — @Model.City</span>
                    }
                }
                else if (!string.IsNullOrEmpty(Model.City))
                {
                    <i class="bi bi-geo-alt-fill" style="color:var(--accent);"></i>
                    @Model.City
                }
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("PropertyManager"))
            {
                <a asp-action="Edit" asp-route-id="@Model.PropertyId" class="ux-btn-outline">
                    <i class="bi bi-pencil-fill"></i> Edit
                </a>
                <button type="button" class="ux-btn-danger" data-bs-toggle="modal" data-bs-target="#deletePropertyModal">
                    <i class="bi bi-trash-fill"></i> Delete
                </button>
            }
            <a asp-controller="Units" asp-action="Index" asp-route-id="@Model.PropertyId" class="ux-btn-primary">
                <i class="bi bi-grid-fill"></i> View Units
            </a>
            <a asp-action="Index" class="ux-btn-ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    @* ── Property Hero Image ── *@
    @if (Model.ImageData != null)
    {
        <div class="prop-details-hero">
            <img src="@Url.Action("GetImage", new { id = Model.PropertyId })"
                 alt="@Model.Name" class="prop-details-hero-img" />
            <div class="prop-details-hero-overlay">
                <span class="prop-details-hero-badge">
                    <i class="bi bi-building-fill me-1"></i>@(Model.Governorate?.Name ?? "Property")
                </span>
            </div>
        </div>
    }

    <div class="ux-details-main" style="display:flex;flex-direction:column;gap:1.25rem;">

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-info-circle-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Property Overview</h3>
                    <p class="ux-form-section-sub">General information about this property.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Property Name</span>
                    <span class="ux-detail-value">@Model.Name</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Governorate</span>
                    <span class="ux-detail-value">@(Model.Governorate?.Name ?? "—")</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">City</span>
                    <span class="ux-detail-value">@Model.City</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Created</span>
                    <span class="ux-detail-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="ux-detail-item" style="grid-column:1/-1;">
                        <span class="ux-detail-label">Description</span>
                        <span class="ux-detail-value">@Model.Description</span>
                    </div>
                }
            </div>
        </div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Location Details</h3>
                    <p class="ux-form-section-sub">Full address breakdown.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label"><i class="bi bi-grid-3x3-gap-fill" style="color:var(--accent);margin-right:0.3rem;"></i>Block</span>
                    <span class="ux-detail-value">@Model.Block</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label"><i class="bi bi-building-fill" style="color:var(--accent);margin-right:0.3rem;"></i>Building</span>
                    <span class="ux-detail-value">@Model.Building</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label"><i class="bi bi-signpost-fill" style="color:var(--accent);margin-right:0.3rem;"></i>Road</span>
                    <span class="ux-detail-value">@Model.Road</span>
                </div>
            </div>
        </div>

    </div>

</div>

@if (User.IsInRole("PropertyManager"))
{
    <div class="modal fade" id="deletePropertyModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Delete Property</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to delete <strong>@Model.Name</strong>? All units under this property will also be deactivated.
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="SoftDelete" asp-route-id="@Model.PropertyId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ux-btn-danger">Confirm Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
