@model IEnumerable<AdvancedProjectAPI.Models.Property>

@{
    ViewData["Title"] = "Properties";
    int propTotal = Model?.Count() ?? 0;
}

<div class="ux-page">

    <div class="ux-page-header">
        <div style="flex:1;">
            @if (User.IsInRole("Tenant"))
            {
                <p class="ux-eyebrow">Available Properties</p>
                <h1 class="ux-title">Properties</h1>
                <p class="ux-subtitle">Browse available properties and find your next home.</p>
            }
            else
            {
                <p class="ux-eyebrow">Property Management</p>
                <h1 class="ux-title">Properties</h1>
                <p class="ux-subtitle">Browse and manage all available properties.</p>
            }
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-start">
            @if (User.IsInRole("PropertyManager"))
            {
                <a asp-action="Create" class="ux-btn-primary">
                    <i class="bi bi-plus-lg"></i> Add Property
                </a>
            }
        </div>
    </div>

    <div class="ux-stats-row">
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                <i class="bi bi-building-fill"></i>
            </div>
            <div>
                <div class="ux-stat-value">@propTotal</div>
                <div class="ux-stat-label">@(User.IsInRole("Tenant") ? "Available Properties" : "Total Properties")</div>
            </div>
        </div>
    </div>

    <div class="ux-toolbar">
        <form asp-action="Index" method="get" class="ux-search-form">
            <div class="ux-search-wrap">
                <i class="bi bi-search ux-search-icon"></i>
                <input type="text" name="searchString"
                       value="@Context.Request.Query["searchString"]"
                       class="ux-search-input" placeholder="Search by name or city..." />
            </div>
            <select name="governorateId" asp-items="ViewBag.Governorates"
                    class="ux-search-input" style="width:180px;padding:0.55rem 0.85rem;border:1.5px solid #e5e7eb;border-radius:8px;font-size:0.875rem;outline:none;">
                <option value="">All Governorates</option>
            </select>
            <button type="submit" class="ux-btn-primary">Search</button>
            <a asp-action="Index" class="ux-btn-ghost">Reset</a>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="ux-table-card">
            <div class="ux-empty">
                <i class="bi bi-building-x"></i>
                <p>No properties found.</p>
            </div>
        </div>
    }
    else
    {
        <div class="prop-card-grid">
            @foreach (var item in Model)
            {
                <div class="prop-card">
                    @* Image or placeholder *@
                    <div class="prop-card-img-wrap">
                        @if (item.ImageData != null)
                        {
                            <img src="@Url.Action("GetImage", new { id = item.PropertyId })"
                                 alt="@item.Name" class="prop-card-img" />
                        }
                        else
                        {
                            <div class="prop-card-img-placeholder">
                                <i class="bi bi-building-fill"></i>
                            </div>
                        }
                        <span class="prop-card-badge">@(item.Governorate?.Name ?? "Property")</span>
                    </div>

                    @* Card body *@
                    <div class="prop-card-body">
                        <h3 class="prop-card-name">@item.Name</h3>
                        <p class="prop-card-location">
                            <i class="bi bi-geo-alt-fill"></i>
                            @item.City@(item.Governorate != null ? ", " + item.Governorate.Name : ""), Bahrain
                        </p>

                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="prop-card-desc">@item.Description</p>
                        }

                        <div class="prop-card-footer">
                            <a asp-action="Details" asp-route-id="@item.PropertyId" class="ux-details-btn">
                                Details <i class="bi bi-arrow-right"></i>
                            </a>
                            <a asp-controller="Units" asp-action="Index" asp-route-id="@item.PropertyId"
                               class="ux-btn-outline" style="font-size:0.8rem;padding:0.38rem 0.85rem;">
                                <i class="bi bi-grid-fill"></i> Units
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @await Html.PartialAsync("_Pagination", (AdvancedProject.ViewModels.PaginationVM)ViewBag.Pagination)

</div>
