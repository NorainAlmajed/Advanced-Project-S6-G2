@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrap auth-wrap--wide">
    <form asp-action="Register" method="post" class="ux-form-layout auth-reg-layout" autocomplete="off">
        <!-- decoy inputs — stop browser from autofilling the real fields -->
        <input type="text" style="display:none" tabindex="-1" autocomplete="username" aria-hidden="true" />
        <input type="password" style="display:none" tabindex="-1" autocomplete="current-password" aria-hidden="true" />

        <div class="auth-reg-header">
            <p class="ux-eyebrow">Create Account</p>
            <h1 class="auth-title">Register as Tenant</h1>
            <p class="ux-subtitle">Fill in your details to create a Rentify account.</p>
        </div>

        <!-- Personal Information -->
        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <p class="ux-form-section-title">Personal Information</p>
                    <p class="ux-form-section-sub">Your identity and contact details</p>
                </div>
            </div>

            <div class="ux-form-grid">
                <div class="ux-field">
                    <label asp-for="FullName" class="ux-label"></label>
                    <input asp-for="FullName" class="ux-input" placeholder="e.g. Ahmed Al-Mansouri" />
                    <span asp-validation-for="FullName" class="ux-field-error"></span>
                </div>

                <div class="ux-field">
                    <label asp-for="Username" class="ux-label"></label>
                    <input asp-for="Username" class="ux-input" placeholder="e.g. ahmed_m" />
                    <span asp-validation-for="Username" class="ux-field-error"></span>
                </div>

                <div class="ux-field">
                    <label asp-for="Email" class="ux-label"></label>
                    <input asp-for="Email" class="ux-input" autocomplete="new-password" placeholder="your@email.com" />
                    <span asp-validation-for="Email" class="ux-field-error"></span>
                </div>

                <div class="ux-field">
                    <label asp-for="Phone" class="ux-label"></label>
                    <input asp-for="Phone" class="ux-input" placeholder="+973 3xxx xxxx" />
                    <span asp-validation-for="Phone" class="ux-field-error"></span>
                </div>

                <div class="ux-field">
                    <label asp-for="Dob" class="ux-label"></label>
                    <input asp-for="Dob" type="date" class="ux-input" />
                    <span asp-validation-for="Dob" class="ux-field-error"></span>
                </div>

                <div class="ux-field">
                    <label asp-for="NationalId" class="ux-label"></label>
                    <input asp-for="NationalId" class="ux-input" placeholder="National ID number" />
                    <span asp-validation-for="NationalId" class="ux-field-error"></span>
                </div>
            </div>

            <div class="ux-field mt-3">
                <label class="ux-label">Gender</label>
                <div class="ux-radio-group">
                    <label class="ux-radio-card">
                        <input asp-for="Gender" type="radio" value="M" />
                        <i class="bi bi-gender-male"></i> Male
                    </label>
                    <label class="ux-radio-card">
                        <input asp-for="Gender" type="radio" value="F" />
                        <i class="bi bi-gender-female"></i> Female
                    </label>
                </div>
                <span asp-validation-for="Gender" class="ux-field-error"></span>
            </div>
        </div>

        <!-- Financial & Status -->
        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <p class="ux-form-section-title">Financial & Status</p>
                    <p class="ux-form-section-sub">Employment and financial information</p>
                </div>
            </div>

            <div class="ux-form-grid">
                <div class="ux-field">
                    <label asp-for="Salary" class="ux-label"></label>
                    <div class="ux-input-prefix-wrap">
                        <span class="ux-input-prefix">BD</span>
                        <input asp-for="Salary" class="ux-input ux-input-prefixed" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Salary" class="ux-field-error"></span>
                </div>

                <div class="ux-field">
                    <label asp-for="MaritalStatus" class="ux-label"></label>
                    <select asp-for="MaritalStatus" class="ux-input">
                        <option value="">— Select status —</option>
                        <option value="Single">Single</option>
                        <option value="Married">Married</option>
                        <option value="Divorced">Divorced</option>
                        <option value="Widowed">Widowed</option>
                    </select>
                    <span asp-validation-for="MaritalStatus" class="ux-field-error"></span>
                </div>

                <div class="ux-field">
                    <label asp-for="EmploymentStatus" class="ux-label"></label>
                    <select asp-for="EmploymentStatus" class="ux-input">
                        <option value="">— Select status —</option>
                        <option value="Employed">Employed</option>
                        <option value="Self-Employed">Self-Employed</option>
                        <option value="Unemployed">Unemployed</option>
                        <option value="Retired">Retired</option>
                    </select>
                    <span asp-validation-for="EmploymentStatus" class="ux-field-error"></span>
                </div>
            </div>
        </div>

        <!-- Account Security -->
        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(245,158,11,0.1);color:#d97706;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <p class="ux-form-section-title">Account Security</p>
                    <p class="ux-form-section-sub">Create a strong password for your account</p>
                </div>
            </div>

            <div class="ux-form-grid">
                <div class="ux-field">
                    <label asp-for="Password" class="ux-label"></label>
                    <input asp-for="Password" class="ux-input" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="ux-field-error"></span>
                </div>

                <div class="ux-field">
                    <label asp-for="ConfirmPassword" class="ux-label"></label>
                    <input asp-for="ConfirmPassword" class="ux-input" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="ux-field-error"></span>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="ux-form-actions">
            <button type="submit" class="ux-btn-primary" style="padding:0.6rem 1.75rem;font-size:0.9rem;">
                Create Account <i class="bi bi-arrow-right ms-1"></i>
            </button>
            <p class="auth-footer-text" style="margin:0;">
                Already have an account?
                <a asp-action="Login" class="auth-link">Sign in here</a>
            </p>
        </div>

    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
