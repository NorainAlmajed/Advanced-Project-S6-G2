@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrap">
    <div class="auth-card">

        <div class="auth-card-header">
            <p class="ux-eyebrow">Welcome back</p>
            <h1 class="auth-title">Sign in to Rentify</h1>
            <p class="ux-subtitle">Enter your credentials to access your account.</p>
        </div>

        <form asp-action="Login" method="post" autocomplete="off">
            <!-- decoy inputs — stop browser from autofilling the real fields -->
            <input type="text" style="display:none" tabindex="-1" autocomplete="username" aria-hidden="true" />
            <input type="password" style="display:none" tabindex="-1" autocomplete="current-password" aria-hidden="true" />

            <div class="ux-field mb-3">
                <label asp-for="Email" class="ux-label"></label>
                <input asp-for="Email" class="ux-input" autocomplete="new-password" placeholder="your@email.com" />
                <span asp-validation-for="Email" class="ux-field-error"></span>
            </div>

            <div class="ux-field mb-4">
                <label asp-for="Password" class="ux-label"></label>
                <input asp-for="Password" class="ux-input" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="ux-field-error"></span>
            </div>

            <div class="auth-remember mb-4">
                <label class="auth-checkbox-label">
                    <input asp-for="RememberMe" type="checkbox" class="auth-checkbox" />
                    <span>Remember me</span>
                </label>
            </div>

            <button type="submit" class="ux-btn-primary auth-submit-btn">
                Sign In <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </form>

        <p class="auth-footer-text">
            Don't have an account?
            <a asp-action="Register" class="auth-link">Register here</a>
        </p>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
