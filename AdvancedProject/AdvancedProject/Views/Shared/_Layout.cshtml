<!DOCTYPE html>
@using Microsoft.AspNetCore.Identity
@using AdvancedProjectAPI.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentUser = null;
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
    string initials = currentUser?.FullName?.Length > 0
        ? currentUser.FullName[0].ToString().ToUpper()
        : "U";
}

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rentify</title>
    <link rel="icon" type="image/png" sizes="1000x1000" href="~/images/logo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdvancedProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    <style>
        .notif-bell-wrapper { position: relative; display: inline-flex; align-items: center; }
        .notif-badge {
            position: absolute; top: -6px; right: -8px;
            background: #ef4444; color: #fff; font-size: 10px; font-weight: 700;
            min-width: 16px; height: 16px; border-radius: 8px; padding: 0 4px;
            display: flex; align-items: center; justify-content: center; line-height: 1;
        }
        #notif-toast-container {
            position: fixed; top: 1.2rem; right: 1.2rem; z-index: 9999;
            display: flex; flex-direction: column; gap: 0.6rem;
            max-width: 360px; pointer-events: none;
        }
        .notif-rt-toast {
            background: #fff; border-left: 4px solid #6366f1;
            border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,.13);
            padding: 0.85rem 1rem; display: flex; align-items: flex-start;
            gap: 0.7rem; pointer-events: all; animation: notif-slide-in 0.3s ease;
        }
        .notif-rt-toast .notif-icon { font-size: 1.25rem; color: #6366f1; flex-shrink: 0; margin-top: 2px; }
        .notif-rt-toast .notif-body { flex: 1; }
        .notif-rt-toast .notif-title { font-weight: 600; font-size: .85rem; color: #1e293b; margin-bottom: 2px; }
        .notif-rt-toast .notif-msg { font-size: .8rem; color: #475569; line-height: 1.4; }
        .notif-rt-toast .notif-time { font-size: .72rem; color: #94a3b8; margin-top: 4px; }
        .notif-rt-toast .notif-close { background: none; border: none; cursor: pointer; color: #94a3b8; font-size: 1rem; padding: 0; line-height: 1; }
        @@keyframes notif-slide-in {
            from { transform: translateX(110%); opacity: 0; }
            to   { transform: translateX(0);    opacity: 1; }
        }
    </style>
</head>
<body class="sidebar-layout">

    <!-- Mobile toggle -->
    <button class="sidebar-mobile-toggle" id="sidebarToggle">
        <i class="bi bi-list"></i>
    </button>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ── SIDEBAR (brand + nav only) ── -->
    <aside class="sidebar" id="mainSidebar">

        <div class="sidebar-brand">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-buildings-fill"></i>
                <span>Rentify</span>
            </a>
        </div>

        <nav class="sidebar-nav">
            <ul>
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Home</span>
                    </a>
                </li>

                @if (User.IsInRole("PropertyManager"))
                {
                    <li>
                        <a asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people-fill"></i>
                            <span>Users</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Properties" asp-action="Index">
                            <i class="bi bi-building-fill"></i>
                            <span>Properties</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="LeaseApplications" asp-action="Index">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span>Applications</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Leases" asp-action="Index">
                            <i class="bi bi-file-earmark-check-fill"></i>
                            <span>Leases</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="MaintenanceRequests" asp-action="Index">
                            <i class="bi bi-wrench-adjustable"></i>
                            <span>Requests</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Payments" asp-action="Index">
                            <i class="bi bi-credit-card-fill"></i>
                            <span>Payments</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="PropertyManagers" asp-action="MyProfile">
                            <i class="bi bi-person-fill"></i>
                            <span>My Profile</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Tenant"))
                {
                    <li>
                        <a asp-controller="Properties" asp-action="Index">
                            <i class="bi bi-building-fill"></i>
                            <span>Properties</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="LeaseApplications" asp-action="Index">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span>Applications</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Leases" asp-action="Index">
                            <i class="bi bi-file-earmark-check-fill"></i>
                            <span>Leases</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="MaintenanceRequests" asp-action="Index">
                            <i class="bi bi-wrench-adjustable"></i>
                            <span>Requests</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Payments" asp-action="Index">
                            <i class="bi bi-credit-card-fill"></i>
                            <span>Payments</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Tenants" asp-action="MyProfile">
                            <i class="bi bi-person-fill"></i>
                            <span>My Profile</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("MaintenanceStaff"))
                {
                    <li>
                        <a asp-controller="MaintenanceRequests" asp-action="Index">
                            <i class="bi bi-wrench-adjustable"></i>
                            <span>Requests</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="MaintenanceStaffs" asp-action="MyProfile">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>My Profile</span>
                        </a>
                    </li>
                }

                @if (!SignInManager.IsSignedIn(User))
                {
                    <li>
                        <a asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>Register</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

    </aside>

    <!-- ── MAIN WRAPPER ── -->
    <div class="sidebar-main-wrapper">

        <!-- ── TOP HEADER BAR ── -->
        @if (SignInManager.IsSignedIn(User))
        {
            <header class="top-header">
                <div class="top-header-user">
                    <div class="sidebar-user-avatar">@initials</div>
                    <span class="top-header-name">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                </div>

                <div class="top-header-actions">
                    <a asp-controller="Notifications" asp-action="Index" class="top-header-btn" title="Notifications">
                        <span class="notif-bell-wrapper">
                            <i class="bi bi-bell-fill"></i>
                            <span id="notif-badge" class="notif-badge" style="display:none;">0</span>
                        </span>
                        <span>Notifications</span>
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="top-header-logout-form" id="logoutForm">
                        @Html.AntiForgeryToken()
                        <button type="button" class="top-header-logout-btn" title="Logout"
                                data-bs-toggle="modal" data-bs-target="#logoutModal">
                            <i class="bi bi-box-arrow-left"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </header>
        }

        <!-- ── PAGE CONTENT ── -->
        <div class="sidebar-main-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="ux-success-toast" id="uxSuccessToast">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["SuccessMessage"]</span>
                    <button class="ux-toast-close" type="button" onclick="this.parentElement.remove()" title="Dismiss">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }
            @RenderBody()
        </div>

    </div>

    <!-- ── FOOTER (outside main wrapper so it truly spans edge-to-edge) ── -->
    <footer class="app-footer">
        <div class="footer-top">
            <div class="footer-col footer-brand-col">
                <div class="footer-brand-name">
                    <i class="bi bi-buildings-fill"></i> Rentify
                </div>
                <p class="footer-brand-desc">
                    Providing seamless property management solutions. Efficiency and transparency in every lease.
                </p>
            </div>

            <div class="footer-col">
                <h6 class="footer-col-title">Quick Links</h6>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Properties" asp-action="Index">Properties</a></li>
                    <li><a asp-controller="MaintenanceRequests" asp-action="Index">Maintenance</a></li>
                    <li><a asp-controller="Leases" asp-action="Index">Leases</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h6 class="footer-col-title">Support</h6>
                <ul class="footer-links footer-contact">
                    <li><i class="bi bi-geo-alt-fill"></i> Manama, Bahrain</li>
                    <li><i class="bi bi-envelope-fill"></i> support@rentify.com</li>
                    <li><i class="bi bi-telephone-fill"></i> +973 1700 0000</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; 2026 Rentify Platform. All rights reserved.</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>

    <!-- Logout Confirmation Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Confirm Logout</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    Are you sure you want to logout?
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light-custom" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="ux-btn-danger" onclick="document.getElementById('logoutForm').submit();">Logout</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <div id="notif-toast-container"></div>

    <script>
        const sidebarToggle  = document.getElementById('sidebarToggle');
        const mainSidebar    = document.getElementById('mainSidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', () => {
                mainSidebar.classList.toggle('open');
                sidebarOverlay.classList.toggle('show');
            });
        }
        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', () => {
                mainSidebar.classList.remove('open');
                sidebarOverlay.classList.remove('show');
            });
        }
    </script>

    @if (SignInManager.IsSignedIn(User))
    {
        <script>
        // Globally accessible so TempData-driven toasts can also call it
        function showNotifToast(data) {
            var container = document.getElementById('notif-toast-container');
            if (!container) return;
            var iconMap = {
                Maintenance: 'bi-wrench-adjustable-circle-fill',
                Payment:     'bi-credit-card-fill',
                Lease:       'bi-file-earmark-check-fill'
            };
            var icon = iconMap[data.typeName] || 'bi-bell-fill';

            var toast = document.createElement('div');
            toast.className = 'notif-rt-toast';
            toast.innerHTML =
                '<i class="bi ' + icon + ' notif-icon"></i>' +
                '<div class="notif-body">' +
                    '<div class="notif-title">' + escHtml(data.title) + '</div>' +
                    '<div class="notif-msg">'   + escHtml(data.message) + '</div>' +
                    '<div class="notif-time">'  + escHtml(data.createdAt) + '</div>' +
                '</div>' +
                '<button class="notif-close" title="Dismiss"><i class="bi bi-x-lg"></i></button>';

            toast.querySelector('.notif-close').addEventListener('click', function () {
                toast.remove();
            });
            container.appendChild(toast);

            setTimeout(function () {
                toast.style.transition = 'opacity 0.4s ease';
                toast.style.opacity = '0';
                setTimeout(function () { toast.remove(); }, 400);
            }, 7000);
        }

        function escHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        (function () {
            var badge = document.getElementById('notif-badge');
            var unreadCount = 0;

            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/notifications')
                .withAutomaticReconnect()
                .build();

            connection.on('ReceiveNotification', function (data) {
                unreadCount++;
                badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                badge.style.display = 'flex';
                showNotifToast(data);
            });

            connection.start().catch(function (err) {
                console.error('NotificationHub error:', err);
            });
        })();
        </script>
    }

    @if (TempData["ToastTitle"] != null)
    {
        <script>
        document.addEventListener('DOMContentLoaded', function () {
            showNotifToast({
                title:     @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastTitle"]?.ToString())),
                message:   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"]?.ToString())),
                typeName:  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastType"]?.ToString() ?? "Maintenance")),
                createdAt: '@Html.Raw(DateTime.Now.ToString("dd MMM yyyy · hh:mm tt"))'
            });
        });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Inject back button on all inner (ux-page) pages
        (function () {
            var page = document.querySelector('.ux-page');
            if (!page) return;
            var header = page.querySelector('.ux-page-header');
            if (!header) return;
            var btn = document.createElement('button');
            btn.className = 'ux-back-btn';
            btn.type = 'button';
            btn.innerHTML = '<i class="bi bi-arrow-left-short" style="font-size:1rem;"></i> Back';
            btn.addEventListener('click', function () { history.back(); });
            header.insertAdjacentElement('beforebegin', btn);
        })();
    </script>

    <script>
        // Auto-dismiss success toast after 4 seconds
        (function () {
            var toast = document.getElementById('uxSuccessToast');
            if (toast) {
                setTimeout(function () {
                    toast.style.transition = 'opacity 0.4s ease';
                    toast.style.opacity = '0';
                    setTimeout(function () { toast.remove(); }, 400);
                }, 4000);
            }
        })();
    </script>
</body>
</html>
