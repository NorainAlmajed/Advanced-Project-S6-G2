<!DOCTYPE html>
@using Microsoft.AspNetCore.Identity
@using AdvancedProjectAPI.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentUser = null;
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
    string initials = currentUser?.FullName?.Length > 0
        ? currentUser.FullName[0].ToString().ToUpper()
        : "U";
}

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rentify</title>
    <link rel="icon" type="image/png" sizes="1000x1000" href="~/images/logo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdvancedProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
</head>
<body class="sidebar-layout">

    <!-- Mobile toggle -->
    <button class="sidebar-mobile-toggle" id="sidebarToggle">
        <i class="bi bi-list"></i>
    </button>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ── SIDEBAR (brand + nav only) ── -->
    <aside class="sidebar" id="mainSidebar">

        <div class="sidebar-brand">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-buildings-fill"></i>
                <span>Rentify</span>
            </a>
        </div>

        <nav class="sidebar-nav">
            <ul>
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Home</span>
                    </a>
                </li>

                @if (User.IsInRole("PropertyManager"))
                {
                    <li>
                        <a asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people-fill"></i>
                            <span>Users</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Properties" asp-action="Index">
                            <i class="bi bi-building-fill"></i>
                            <span>Properties</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="LeaseApplications" asp-action="Index">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span>Applications</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Leases" asp-action="Index">
                            <i class="bi bi-file-earmark-check-fill"></i>
                            <span>Leases</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="MaintenanceRequests" asp-action="Index">
                            <i class="bi bi-wrench-adjustable"></i>
                            <span>Requests</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Payments" asp-action="Index">
                            <i class="bi bi-credit-card-fill"></i>
                            <span>Payments</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="PropertyManagers" asp-action="MyProfile">
                            <i class="bi bi-person-fill"></i>
                            <span>My Profile</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Tenant"))
                {
                    <li>
                        <a asp-controller="Properties" asp-action="Index">
                            <i class="bi bi-building-fill"></i>
                            <span>Properties</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="LeaseApplications" asp-action="Index">
                            <i class="bi bi-file-earmark-text-fill"></i>
                            <span>Applications</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Leases" asp-action="Index">
                            <i class="bi bi-file-earmark-check-fill"></i>
                            <span>Leases</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="MaintenanceRequests" asp-action="Index">
                            <i class="bi bi-wrench-adjustable"></i>
                            <span>Requests</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Payments" asp-action="Index">
                            <i class="bi bi-credit-card-fill"></i>
                            <span>Payments</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Tenants" asp-action="MyProfile">
                            <i class="bi bi-person-fill"></i>
                            <span>My Profile</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("MaintenanceStaff"))
                {
                    <li>
                        <a asp-controller="MaintenanceRequests" asp-action="Index">
                            <i class="bi bi-wrench-adjustable"></i>
                            <span>Requests</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="MaintenanceStaffs" asp-action="MyProfile">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>My Profile</span>
                        </a>
                    </li>
                }

                @if (!SignInManager.IsSignedIn(User))
                {
                    <li>
                        <a asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Login</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>Register</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

    </aside>

    <!-- ── MAIN WRAPPER ── -->
    <div class="sidebar-main-wrapper">

        <!-- ── TOP HEADER BAR ── -->
        @if (SignInManager.IsSignedIn(User))
        {
            <header class="top-header">
                <div class="top-header-user">
                    <div class="sidebar-user-avatar">@initials</div>
                    <span class="top-header-name">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                </div>

                <div class="top-header-actions">
                    <a asp-controller="Notifications" asp-action="Index" class="top-header-btn" title="Notifications">
                        <i class="bi bi-bell-fill"></i>
                        <span>Notifications</span>
                    </a>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="top-header-logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="top-header-logout-btn" title="Logout" onclick="return confirm('Are you sure you want to logout?');">
                            <i class="bi bi-box-arrow-left"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </header>
        }

        <!-- ── PAGE CONTENT ── -->
        <div class="sidebar-main-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="ux-success-toast" id="uxSuccessToast">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["SuccessMessage"]</span>
                    <button class="ux-toast-close" type="button" onclick="this.parentElement.remove()" title="Dismiss">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }
            @RenderBody()
        </div>

    </div>

    <!-- ── FOOTER (outside main wrapper so it truly spans edge-to-edge) ── -->
    <footer class="app-footer">
        <div class="footer-top">
            <div class="footer-col footer-brand-col">
                <div class="footer-brand-name">
                    <i class="bi bi-buildings-fill"></i> Rentify
                </div>
                <p class="footer-brand-desc">
                    Providing seamless property management solutions. Efficiency and transparency in every lease.
                </p>
            </div>

            <div class="footer-col">
                <h6 class="footer-col-title">Quick Links</h6>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Properties" asp-action="Index">Properties</a></li>
                    <li><a asp-controller="MaintenanceRequests" asp-action="Index">Maintenance</a></li>
                    <li><a asp-controller="Leases" asp-action="Index">Leases</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h6 class="footer-col-title">Support</h6>
                <ul class="footer-links footer-contact">
                    <li><i class="bi bi-geo-alt-fill"></i> Manama, Bahrain</li>
                    <li><i class="bi bi-envelope-fill"></i> support@rentify.com</li>
                    <li><i class="bi bi-telephone-fill"></i> +973 1700 0000</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; 2026 Rentify Platform. All rights reserved.</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

    <script>
        const sidebarToggle  = document.getElementById('sidebarToggle');
        const mainSidebar    = document.getElementById('mainSidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', () => {
                mainSidebar.classList.toggle('open');
                sidebarOverlay.classList.toggle('show');
            });
        }
        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', () => {
                mainSidebar.classList.remove('open');
                sidebarOverlay.classList.remove('show');
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Auto-dismiss success toast after 4 seconds
        (function () {
            var toast = document.getElementById('uxSuccessToast');
            if (toast) {
                setTimeout(function () {
                    toast.style.transition = 'opacity 0.4s ease';
                    toast.style.opacity = '0';
                    setTimeout(function () { toast.remove(); }, 400);
                }, 4000);
            }
        })();
    </script>
</body>
</html>
