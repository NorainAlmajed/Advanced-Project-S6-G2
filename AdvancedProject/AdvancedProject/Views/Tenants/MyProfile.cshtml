@model AdvancedProjectAPI.Models.Tenant

@{
    ViewData["Title"] = "My Profile";
    string fullName = Model.User?.FullName ?? "—";
    string username = Model.User?.Username ?? "—";
    string email = Model.User?.Email ?? "—";
    string phone = Model.User?.Phone ?? "—";
    string genderText = Model.User?.Gender == "F" ? "Female" : "Male";
    string dob = Model.Dob.ToString("dd MMM yyyy");
    string salary = Model.Salary.HasValue ? "BD " + Model.Salary.Value.ToString("0.00") : "—";
    string marital = Model.MaritalStatus ?? "—";
    string employment = Model.EmploymentStatus ?? "—";
    string financial = Model.FinancialStability ?? "Undetermined";

    string financialClass = financial switch
    {
        "Stable" => "badge-soft-active",
        "Moderately Stable" => "badge-soft-manager",
        "Unstable" => "badge-soft-inactive",
        _ => "badge-soft-default"
    };
}

<div class="ux-page">

    <div class="ux-page-header">
        <div style="flex:1;">
            <p class="ux-eyebrow">My Account</p>
            <h1 class="ux-title">@fullName</h1>
            <p class="ux-subtitle">
                <i class="bi bi-at" style="color:var(--accent);"></i>@username
                <span style="margin:0 0.4rem;color:var(--text-muted);">&middot;</span>
                Tenant
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="EditMyProfile" class="ux-btn-outline">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ux-alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="ux-details-main" style="display:flex;flex-direction:column;gap:1.25rem;">

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Personal Information</h3>
                    <p class="ux-form-section-sub">Your identity and contact details.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Full Name</span>
                    <span class="ux-detail-value">@fullName</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Username</span>
                    <span class="ux-detail-value">@username</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Email</span>
                    <span class="ux-detail-value">@email</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Phone</span>
                    <span class="ux-detail-value">@phone</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Gender</span>
                    <span class="ux-detail-value">@genderText</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Date of Birth</span>
                    <span class="ux-detail-value">@dob</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">National ID</span>
                    <span class="ux-detail-value">@Model.NationalId</span>
                </div>
            </div>
        </div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(245,158,11,0.1);color:#d97706;">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Financial & Status</h3>
                    <p class="ux-form-section-sub">Your financial background and employment details.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Salary</span>
                    <span class="ux-detail-value">@salary</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Marital Status</span>
                    <span class="ux-detail-value">@marital</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Employment Status</span>
                    <span class="ux-detail-value">@employment</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Financial Stability</span>
                    <span class="ux-detail-value">
                        <span class="custom-pill @financialClass">@financial</span>
                    </span>
                </div>
            </div>
        </div>

    </div>

</div>
