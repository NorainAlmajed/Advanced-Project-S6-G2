@model TenantCreateVM

@{
    ViewData["Title"] = "Create Tenant";
}

<div class="tenant-form-page">
    <div class="lease-form-wrapper">
        <div class="lease-form-card shadow-soft">

            <div class="lease-form-header">
                <p class="lease-form-eyebrow mb-2">Tenant</p>
                <h1 class="lease-form-title mb-2">Create Tenant</h1>
                <p class="lease-form-subtitle mb-0">
                    Add a new tenant account and tenant screening information.
                </p>
            </div>

            <form asp-action="Create" method="post" class="lease-form-body">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Username" class="lease-form-label"></label>
                        <input asp-for="Username" class="form-control lease-form-input" placeholder="Enter username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Password" class="lease-form-label"></label>
                        <input asp-for="Password" type="password" class="form-control lease-form-input" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="ConfirmPassword" class="lease-form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control lease-form-input" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="FullName" class="lease-form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control lease-form-input" placeholder="Enter full name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Email" class="lease-form-label"></label>
                        <input asp-for="Email" type="email" class="form-control lease-form-input" placeholder="Enter email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Phone" class="lease-form-label"></label>
                        <input asp-for="Phone" class="form-control lease-form-input" placeholder="Enter phone number" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label class="lease-form-label">Gender</label>

                        <div class="tenant-radio-group">
                            <label class="tenant-radio-card">
                                <input type="radio" asp-for="Gender" value="M" />
                                <span>Male</span>
                            </label>

                            <label class="tenant-radio-card">
                                <input type="radio" asp-for="Gender" value="F" />
                                <span>Female</span>
                            </label>
                        </div>

                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Dob" class="lease-form-label">Date of Birth</label>
                        <input asp-for="Dob" type="date" class="form-control lease-form-input" />
                        <span asp-validation-for="Dob" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="NationalId" class="lease-form-label">National ID</label>
                        <input asp-for="NationalId" class="form-control lease-form-input" placeholder="Enter national ID" />
                        <span asp-validation-for="NationalId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="Salary" class="lease-form-label"></label>
                        <input asp-for="Salary" type="text" class="form-control lease-form-input" placeholder="Enter salary" />                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="MaritalStatus" class="lease-form-label">Marital Status</label>
                        <select asp-for="MaritalStatus" class="form-control lease-form-input">
                            <option value="">-- Select Marital Status --</option>
                            <option value="Single">Single</option>
                            <option value="Married">Married</option>
                            <option value="Divorced">Divorced</option>
                            <option value="Widowed">Widowed</option>
                        </select>
                        <span asp-validation-for="MaritalStatus" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 lease-form-group">
                        <label asp-for="EmploymentStatus" class="lease-form-label">Employment Status</label>
                        <select asp-for="EmploymentStatus" class="form-control lease-form-input">
                            <option value="">-- Select Employment Status --</option>
                            <option value="Employed">Employed</option>
                            <option value="Unemployed">Unemployed</option>
                            <option value="Self-Employed">Self-Employed</option>
                            <option value="Student">Student</option>
                            <option value="Retired">Retired</option>
                        </select>
                        <span asp-validation-for="EmploymentStatus" class="text-danger"></span>
                    </div>

                </div>

                <div class="lease-form-actions">
                    <button type="submit" class="btn btn-primary lease-submit-btn">
                        Create Tenant
                    </button>

                    <a asp-action="Index" class="lease-back-link">
                        Back to List
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}