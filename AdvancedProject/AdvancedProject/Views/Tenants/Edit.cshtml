@model TenantEditVM

@{
    ViewData["Title"] = "Edit Tenant";
}

<div class="tenant-form-page">
    <div class="lease-form-wrapper">
        <div class="lease-form-card shadow-soft">

            <!-- Header -->
            <div class="lease-form-header">
                <p class="lease-form-eyebrow mb-2">Tenant</p>

                <h1 class="lease-form-title mb-2">
                    Edit Tenant
                </h1>

                <p class="lease-form-subtitle mb-0">
                    Update tenant profile, account information, and financial details.
                </p>
            </div>

            <!-- Body -->
            <div class="lease-form-body">

                <form asp-action="Edit" method="post">

                    <input type="hidden" asp-for="TenantId" />
                    <input type="hidden" asp-for="UserId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <div class="row g-4">

                        <!-- Username -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">Username</label>
                                <input asp-for="Username" class="form-control lease-form-input" />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Full Name -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">Full Name</label>
                                <input asp-for="FullName" class="form-control lease-form-input" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control lease-form-input" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">Phone</label>
                                <input asp-for="Phone" class="form-control lease-form-input" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">
                                    Password
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control lease-form-input"
                                       placeholder="Leave empty to keep current password" />

                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">Confirm Password</label>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control lease-form-input"
                                       placeholder="Confirm new password" />

                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Gender -->
                        <div class="col-12">
                            <div class="lease-form-group">
                                <label class="lease-form-label d-block mb-3">
                                    Gender
                                </label>

                                <div class="tenant-radio-group">

                                    <label class="tenant-radio-card">
                                        <input type="radio" asp-for="Gender" value="M" />
                                        Male
                                    </label>

                                    <label class="tenant-radio-card">
                                        <input type="radio" asp-for="Gender" value="F" />
                                        Female
                                    </label>

                                </div>

                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- DOB -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">Date of Birth</label>
                                <input asp-for="Dob" type="date" class="form-control lease-form-input" />
                                <span asp-validation-for="Dob" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- National ID -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">National ID</label>
                                <input asp-for="NationalId" class="form-control lease-form-input" />
                                <span asp-validation-for="NationalId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Salary -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">Salary</label>

                                <input asp-for="Salary"
                                       type="text"
                                       class="form-control lease-form-input" />

                                <span asp-validation-for="Salary" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Financial Stability -->
                        <div class="col-md-6">
                            <div class="lease-form-group">
                                <label class="lease-form-label">
                                    Financial Stability
                                </label>

                                <select asp-for="FinancialStability"
                                        class="form-select lease-form-input">

                                    @if (Model.FinancialStability == "Undetermined")
                                    {
                                        <option value="Undetermined" disabled>
                                            Undetermined
                                        </option>
                                    }

                                    <option value="Stable">Stable</option>
                                    <option value="Moderately Stable">
                                        Moderately Stable
                                    </option>
                                    <option value="Unstable">Unstable</option>

                                </select>

                                <span asp-validation-for="FinancialStability" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Marital Status -->
                        <div class="col-md-6">
                            <div class="lease-form-group">

                                <label class="lease-form-label">
                                    Marital Status
                                </label>

                                <select asp-for="MaritalStatus"
                                        class="form-select lease-form-input">

                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                    <option value="Divorced">Divorced</option>
                                    <option value="Widowed">Widowed</option>

                                </select>

                                <span asp-validation-for="MaritalStatus" class="text-danger"></span>

                            </div>
                        </div>

                        <!-- Employment Status -->
                        <div class="col-md-6">
                            <div class="lease-form-group">

                                <label class="lease-form-label">
                                    Employment Status
                                </label>

                                <select asp-for="EmploymentStatus"
                                        class="form-select lease-form-input">

                                    <option value="Employed">Employed</option>
                                    <option value="Unemployed">Unemployed</option>
                                    <option value="Self-Employed">Self-Employed</option>
                                    <option value="Student">Student</option>
                                    <option value="Retired">Retired</option>

                                </select>

                                <span asp-validation-for="EmploymentStatus" class="text-danger"></span>

                            </div>
                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="lease-form-actions">

                        <button type="submit"
                                class="ux-btn-primary">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="ux-btn-ghost">
                            Back to Tenants
                        </a>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}