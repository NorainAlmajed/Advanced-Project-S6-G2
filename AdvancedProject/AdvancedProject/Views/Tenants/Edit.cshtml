@model TenantEditVM
@{
    ViewData["Title"] = "Edit";
}
<h1>Edit</h1>
<h4>Tenant</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="TenantId" />
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Username -->
            <div class="form-group">
                <label>Username</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="form-group">
                <label>Password (leave empty to keep current)</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-group">
                <label>Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Full Name -->
            <div class="form-group">
                <label>Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Phone -->
            <div class="form-group">
                <label>Phone</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <!-- Gender -->
            <div class="form-group">
                <label>Gender</label><br />
                <input type="radio" asp-for="Gender" value="M" /> Male
                <input type="radio" asp-for="Gender" value="F" /> Female
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <!-- DOB -->
            <div class="form-group">
                <label>Date of Birth</label>
                <input asp-for="Dob" type="date" class="form-control" />
                <span asp-validation-for="Dob" class="text-danger"></span>
            </div>

            <!-- National ID -->
            <div class="form-group">
                <label>National ID</label>
                <input asp-for="NationalId" class="form-control" />
                <span asp-validation-for="NationalId" class="text-danger"></span>
            </div>

            <!-- Salary -->
            <div class="form-group">
                <label>Salary</label>
                <input asp-for="Salary" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Salary" class="text-danger"></span>
            </div>

            <!-- Financial Stability (edit only, no Undetermined option) -->
            <div class="form-group">
                <label>Financial Stability</label>
                <select asp-for="FinancialStability" class="form-control">
                    @if (Model.FinancialStability == "Undetermined")
                    {
                        <option value="Undetermined" disabled>Undetermined</option>
                    }
                    <option value="Stable">Stable</option>
                    <option value="Moderately Stable">Moderately Stable</option>
                    <option value="Unstable">Unstable</option>
                </select>
                <span asp-validation-for="FinancialStability" class="text-danger"></span>
            </div>

            <!-- Marital Status -->
            <div class="form-group">
                <label>Marital Status</label>
                <select asp-for="MaritalStatus" class="form-control">
                    <option value="Single">Single</option>
                    <option value="Married">Married</option>
                    <option value="Divorced">Divorced</option>
                    <option value="Widowed">Widowed</option>
                </select>
                <span asp-validation-for="MaritalStatus" class="text-danger"></span>
            </div>

            <!-- Employment Status -->
            <div class="form-group">
                <label>Employment Status</label>
                <select asp-for="EmploymentStatus" class="form-control">
                    <option value="Employed">Employed</option>
                    <option value="Unemployed">Unemployed</option>
                    <option value="Self-Employed">Self-Employed</option>
                    <option value="Student">Student</option>
                    <option value="Retired">Retired</option>
                </select>
                <span asp-validation-for="EmploymentStatus" class="text-danger"></span>
            </div>

            <br />
            <input type="submit" value="Save" class="btn btn-primary" />
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}