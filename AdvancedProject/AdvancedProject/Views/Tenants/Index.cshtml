@model IEnumerable<AdvancedProjectAPI.Models.User>

@{
    ViewData["Title"] = "Tenants";
    string currentSearch = ViewData["CurrentSearchTerm"]?.ToString() ?? "";
    int totalTenants = (int)(ViewData["TotalTenants"] ?? 0);
}

<div class="ux-page">

    <div class="ux-page-header">
        <div style="flex:1;">
            <p class="ux-eyebrow">User Management</p>
            <h1 class="ux-title">Tenants</h1>
            <p class="ux-subtitle">Browse and manage registered tenants.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-start">
            <a asp-controller="Tenants" asp-action="Create" class="ux-btn-primary">
                <i class="bi bi-person-plus-fill"></i> Add Tenant
            </a>
        </div>
    </div>

    <div class="ux-stats-row">
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background: rgba(30,142,110,0.1); color: #1E8E6E;">
                <i class="bi bi-person-fill"></i>
            </div>
            <div>
                <div class="ux-stat-value">@totalTenants</div>
                <div class="ux-stat-label">Total Tenants</div>
            </div>
        </div>
    </div>

    <div class="ux-toolbar">
        <form asp-action="Index" method="get" class="ux-search-form">
            <div class="ux-search-wrap">
                <i class="bi bi-search ux-search-icon"></i>
                <input type="text" name="searchTerm" value="@currentSearch"
                       class="ux-search-input" placeholder="Search by name, email, phone..." />
            </div>
            <button type="submit" class="ux-btn-primary">Search</button>
            <a asp-action="Index" class="ux-btn-ghost">Reset</a>
        </form>

        <div class="ux-filter-tabs">
            <a asp-controller="Users" asp-action="Index" class="ux-filter-tab">All Users</a>
            <a asp-controller="Tenants" asp-action="Index" class="ux-filter-tab active">Tenants</a>
            <a asp-controller="MaintenanceStaffs" asp-action="Index" class="ux-filter-tab">Staff</a>
        </div>
    </div>

    <div class="ux-table-card">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="ux-table">
                    <thead>
                        <tr>
                            <th>Tenant</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string initial = !string.IsNullOrEmpty(item.FullName) ? item.FullName[0].ToString().ToUpper() : "T";
                            <tr>
                                <td>
                                    <div class="ux-user-cell">
                                        <div class="ux-avatar" style="background:#1E8E6E;">@initial</div>
                                        <div>
                                            <div class="ux-user-name">@item.FullName</div>
                                            <div class="ux-user-sub">@@@item.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="ux-cell-muted">@item.Email</td>
                                <td class="ux-cell-muted">@item.Phone</td>
                                <td><span class="ux-role-badge ux-role-tenant">Tenant</span></td>
                                <td class="text-end">
                                    <a asp-controller="Users" asp-action="Details" asp-route-id="@item.UserId" class="ux-details-btn">
                                        View <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ux-empty">
                <i class="bi bi-person-x"></i>
                <p>No tenants found.</p>
            </div>
        }
    </div>

    @await Html.PartialAsync("_Pagination", (AdvancedProject.ViewModels.PaginationVM)ViewBag.Pagination)

</div>
