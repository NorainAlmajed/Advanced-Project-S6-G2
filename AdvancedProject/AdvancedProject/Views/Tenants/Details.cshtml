@model AdvancedProjectAPI.Models.Tenant

@{
    ViewData["Title"] = "Tenant Details";

    string fullName = Model.User?.FullName ?? "Tenant";
    string username = Model.User?.Username ?? "—";
    string email = Model.User?.Email ?? "—";
    string phone = Model.User?.Phone ?? "—";
    string role = Model.User?.Role ?? "Tenant";
    string dobText = Model.Dob.ToString("dd MMM yyyy");
    string createdAtText = Model.User != null ? Model.User.CreatedAt.ToString("dd MMM yyyy") : "—";
    string genderText = Model.User?.Gender == "F" ? "Female" : "Male";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Tenant Management</p>
            <h1 class="ux-title">@fullName</h1>
            <p class="ux-subtitle">
                <i class="bi bi-at" style="color:var(--accent);"></i>@username
                <span style="margin:0 0.4rem;color:var(--text-muted);">&middot;</span>
                Tenant
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.TenantId" class="ux-btn-outline">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <a asp-action="Index" class="ux-btn-ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="ux-details-main" style="display:flex;flex-direction:column;gap:1.25rem;">

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Personal Information</h3>
                    <p class="ux-form-section-sub">Contact and identity details for this tenant.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Full Name</span>
                    <span class="ux-detail-value">@fullName</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Username</span>
                    <span class="ux-detail-value">@username</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Email</span>
                    <span class="ux-detail-value">@email</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Phone</span>
                    <span class="ux-detail-value">@phone</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Gender</span>
                    <span class="ux-detail-value">@genderText</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Date of Birth</span>
                    <span class="ux-detail-value">@dobText</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Account Created</span>
                    <span class="ux-detail-value">@createdAtText</span>
                </div>
            </div>
        </div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                    <i class="bi bi-file-person-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Tenant Details</h3>
                    <p class="ux-form-section-sub">Financial and tenant-specific records.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">National ID</span>
                    <span class="ux-detail-value">@(string.IsNullOrWhiteSpace(Model.NationalId) ? "—" : Model.NationalId)</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Salary</span>
                    <span class="ux-detail-value">BD @Model.Salary</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Financial Stability</span>
                    <span class="ux-detail-value">@Model.FinancialStability</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Marital Status</span>
                    <span class="ux-detail-value">@Model.MaritalStatus</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Employment Status</span>
                    <span class="ux-detail-value">@Model.EmploymentStatus</span>
                </div>
            </div>
        </div>

    </div>

</div>
