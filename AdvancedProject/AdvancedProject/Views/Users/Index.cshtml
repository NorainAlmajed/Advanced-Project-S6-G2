@model IEnumerable<AdvancedProjectAPI.Models.User>

@{
    ViewData["Title"] = "Users";
    string currentFilter = ViewData["CurrentRoleFilter"]?.ToString() ?? "";
    string currentSearch = ViewData["CurrentSearchTerm"]?.ToString() ?? "";

    int totalUsers   = Model.Count();
    int totalTenants = Model.Count(u => u.Role == "Tenant");
    int totalStaff   = Model.Count(u => u.Role == "MaintenanceStaff" || u.Role == "Staff");
    int totalManagers = Model.Count(u => u.Role == "PropertyManager" || u.Role == "Manager");
}

<div class="ux-page">

    
    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">User Management</p>
            <h1 class="ux-title">Users</h1>
            <p class="ux-subtitle">Browse and manage all system users by role.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Tenants" asp-action="Create" class="ux-btn-primary">
                <i class="bi bi-person-plus-fill"></i> Add Tenant
            </a>
            <a asp-controller="MaintenanceStaffs" asp-action="Create" class="ux-btn-outline">
                <i class="bi bi-tools"></i> Add Staff
            </a>
        </div>
    </div>

    
    <div class="ux-stats-row">
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background: rgba(0,91,113,0.1); color: #005B71;">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="ux-stat-value">@totalUsers</div>
                <div class="ux-stat-label">Total Users</div>
            </div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background: rgba(30,142,110,0.1); color: #1E8E6E;">
                <i class="bi bi-person-fill"></i>
            </div>
            <div>
                <div class="ux-stat-value">@totalTenants</div>
                <div class="ux-stat-label">Tenants</div>
            </div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background: rgba(99,102,241,0.1); color: #6366f1;">
                <i class="bi bi-wrench-adjustable"></i>
            </div>
            <div>
                <div class="ux-stat-value">@totalStaff</div>
                <div class="ux-stat-label">Maintenance Staff</div>
            </div>
        </div>
        <div class="ux-stat-card">
            <div class="ux-stat-icon" style="background: rgba(245,158,11,0.1); color: #d97706;">
                <i class="bi bi-shield-fill"></i>
            </div>
            <div>
                <div class="ux-stat-value">@totalManagers</div>
                <div class="ux-stat-label">Managers</div>
            </div>
        </div>
    </div>

    
    <div class="ux-toolbar">
        <form asp-action="Index" method="get" class="ux-search-form">
            <input type="hidden" name="roleFilter" value="@currentFilter" />
            <div class="ux-search-wrap">
                <i class="bi bi-search ux-search-icon"></i>
                <input type="text"
                       name="searchTerm"
                       value="@currentSearch"
                       class="ux-search-input"
                       placeholder="Search by name, email, phone or role..." />
            </div>
            <button type="submit" class="ux-btn-primary">Search</button>
            <a asp-action="Index" asp-route-roleFilter="@currentFilter" class="ux-btn-ghost">Reset</a>
        </form>

        <div class="ux-filter-tabs">
            <a asp-action="Index" asp-route-searchTerm="@currentSearch"
               class="ux-filter-tab @(string.IsNullOrEmpty(currentFilter) ? "active" : "")">
                All
            </a>
            <a asp-controller="Tenants" asp-action="Index"
               class="ux-filter-tab">
                Tenants
            </a>
            <a asp-controller="MaintenanceStaffs" asp-action="Index"
               class="ux-filter-tab">
                Staff
            </a>
        </div>
    </div>

    
    <div class="ux-table-card">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="ux-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string avatarInitial = !string.IsNullOrEmpty(item.FullName) ? item.FullName[0].ToString().ToUpper() : "U";
                            string avatarColor = item.Role == "Tenant" ? "#1E8E6E" :
                                                 item.Role == "MaintenanceStaff" || item.Role == "Staff" ? "#6366f1" : "#005B71";
                            <tr>
                                <td>
                                    <div class="ux-user-cell">
                                        <div class="ux-avatar" style="background: @avatarColor;">@avatarInitial</div>
                                        <div>
                                            <div class="ux-user-name">@item.FullName</div>
                                            <div class="ux-user-sub">@@@item.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="ux-cell-muted">@item.Email</td>
                                <td class="ux-cell-muted">@item.Phone</td>
                                <td>
                                    <span class="ux-role-badge ux-role-@(item.Role?.ToLower().Replace(" ",""))">
                                        @item.Role
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.UserId" class="ux-details-btn">
                                        View <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ux-empty">
                <i class="bi bi-people"></i>
                <p>No users found.</p>
            </div>
        }
    </div>

</div>
