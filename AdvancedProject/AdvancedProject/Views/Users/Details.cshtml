@model AdvancedProjectAPI.Models.User

@{
    ViewData["Title"] = "User Details";

    string roleClass = Model.Role?.ToLower() switch
    {
        "tenant" => "badge-soft-tenant",
        "manager" => "badge-soft-manager",
        "staff" => "badge-soft-staff",
        _ => "badge-soft-default"
    };

    string genderText = Model.Gender == "F" ? "Female" : "Male";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">User Management</p>
            <h1 class="ux-title">@Model.FullName</h1>
            <p class="ux-subtitle">
                <i class="bi bi-at" style="color:var(--accent);"></i>@Model.Username
                <span style="margin:0 0.4rem;color:var(--text-muted);">&middot;</span>
                <span class="custom-pill @roleClass" style="font-size:0.7rem;">@Model.Role</span>
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="ux-btn-outline">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <a asp-action="Index" class="ux-btn-ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="ux-details-main" style="display:flex;flex-direction:column;gap:1.25rem;">

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Account Information</h3>
                    <p class="ux-form-section-sub">Main account details for this user.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Full Name</span>
                    <span class="ux-detail-value">@Model.FullName</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Username</span>
                    <span class="ux-detail-value">@Model.Username</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Email</span>
                    <span class="ux-detail-value">@Model.Email</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Phone</span>
                    <span class="ux-detail-value">@Model.Phone</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Role</span>
                    <span class="ux-detail-value">
                        <span class="custom-pill @roleClass">@Model.Role</span>
                    </span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Gender</span>
                    <span class="ux-detail-value">@genderText</span>
                </div>
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Account Created</span>
                    <span class="ux-detail-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>

    </div>

</div>
