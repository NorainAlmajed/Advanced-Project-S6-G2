@model AdvancedProject.ViewModels.UserEditVM

@{
    ViewData["Title"] = "Edit User";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">User Management</p>
            <h1 class="ux-title">Edit User</h1>
            <p class="ux-subtitle">Update account credentials and personal information.</p>
        </div>
        <a asp-action="Index" class="ux-btn-ghost">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <form asp-action="Edit" method="post" class="ux-form-layout" autocomplete="off">

        <input type="hidden" asp-for="UserId" />

        <div asp-validation-summary="ModelOnly" class="ux-form-error"></div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-person-lock"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Account Credentials</h3>
                    <p class="ux-form-section-sub">Update the login username and password.</p>
                </div>
            </div>

            <div class="ux-form-grid">
                <div class="ux-field">
                    <label asp-for="Username" class="ux-label"></label>
                    <input asp-for="Username" class="ux-input" placeholder="e.g. john.doe" autocomplete="off" />
                    <span asp-validation-for="Username" class="ux-field-error"></span>
                </div>
                <div></div>
                <div class="ux-field">
                    <label asp-for="Password" class="ux-label">New Password</label>
                    <input asp-for="Password" type="password" class="ux-input" autocomplete="new-password"
                           placeholder="Leave empty to keep current password" />
                    <span asp-validation-for="Password" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="ConfirmPassword" class="ux-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="ux-input" autocomplete="new-password"
                           placeholder="Confirm new password" />
                    <span asp-validation-for="ConfirmPassword" class="ux-field-error"></span>
                </div>
            </div>
        </div>

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(30,142,110,0.1);color:#1E8E6E;">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Personal Information</h3>
                    <p class="ux-form-section-sub">Update identity and contact details.</p>
                </div>
            </div>

            <div class="ux-form-grid">
                <div class="ux-field">
                    <label asp-for="FullName" class="ux-label">Full Name</label>
                    <input asp-for="FullName" class="ux-input" placeholder="e.g. John Doe" />
                    <span asp-validation-for="FullName" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="Email" class="ux-label"></label>
                    <input asp-for="Email" type="email" class="ux-input" placeholder="e.g. john@email.com" />
                    <span asp-validation-for="Email" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label asp-for="Phone" class="ux-label"></label>
                    <input asp-for="Phone" class="ux-input" placeholder="e.g. +973 3300 0000" />
                    <span asp-validation-for="Phone" class="ux-field-error"></span>
                </div>
                <div class="ux-field">
                    <label class="ux-label">Gender</label>
                    <div class="ux-radio-group">
                        <label class="ux-radio-card">
                            <input type="radio" asp-for="Gender" value="M" />
                            <i class="bi bi-gender-male"></i>
                            <span>Male</span>
                        </label>
                        <label class="ux-radio-card">
                            <input type="radio" asp-for="Gender" value="F" />
                            <i class="bi bi-gender-female"></i>
                            <span>Female</span>
                        </label>
                    </div>
                    <span asp-validation-for="Gender" class="ux-field-error"></span>
                </div>
            </div>
        </div>

        <div class="ux-form-actions">
            <button type="submit" class="ux-btn-primary" style="padding:0.65rem 2rem;font-size:0.95rem;">
                <i class="bi bi-check-circle-fill"></i> Save Changes
            </button>
            <a asp-action="Index" class="ux-btn-ghost" style="padding:0.65rem 1.5rem;">
                Cancel
            </a>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $("form").on("submit", function () {
                $(this).validate().element("input[name='Gender']");
            });
        });
    </script>
}
