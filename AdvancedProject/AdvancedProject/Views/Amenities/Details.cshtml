@model AdvancedProjectAPI.Models.Amenity

@{
    ViewData["Title"] = "Amenity Details";
}

<div class="ux-page">

    <div class="ux-page-header">
        <div>
            <p class="ux-eyebrow">Amenities</p>
            <h1 class="ux-title">@Model.Name</h1>
            <p class="ux-subtitle">
                <i class="bi bi-stars" style="color:var(--accent);margin-right:0.3rem;"></i>
                Unit Amenity &amp; Feature
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.AmenityId" class="ux-btn-outline">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <a asp-action="Index" class="ux-btn-ghost">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="ux-details-main" style="display:flex;flex-direction:column;gap:1.25rem;">

        <div class="ux-form-card">
            <div class="ux-form-section-header">
                <div class="ux-form-section-icon" style="background:rgba(0,91,113,0.1);color:#005B71;">
                    <i class="bi bi-stars"></i>
                </div>
                <div>
                    <h3 class="ux-form-section-title">Amenity Information</h3>
                    <p class="ux-form-section-sub">Details about this amenity.</p>
                </div>
            </div>
            <div class="ux-details-grid">
                <div class="ux-detail-item">
                    <span class="ux-detail-label">Amenity Name</span>
                    <span class="ux-detail-value">@Model.Name</span>
                </div>
            </div>
        </div>

    </div>

</div>
